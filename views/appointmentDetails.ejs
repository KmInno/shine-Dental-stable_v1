
<!-- =========================================================
     PATIENT HISTORY / PROFILE PAGE
========================================================= -->

<style>
    /* =========================================================
       DESIGN SYSTEM
    ========================================================= */

    :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --primary-soft: #eff6ff;

        --success: #16a34a;
        --success-soft: #ecfdf3;

        --warning: #d97706;
        --warning-soft: #fffbeb;

        --danger: #dc2626;
        --danger-soft: #fef2f2;

        --text-dark: #1f2937;
        --text: #4b5563;
        --text-muted: #9ca3af;

        --border: #e5e7eb;
        --background: #f5f7fb;
        --surface: #ffffff;

        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;

        --shadow-sm:
            0 2px 8px rgba(15, 23, 42, 0.05);

        --shadow-md:
            0 8px 24px rgba(15, 23, 42, 0.08);

        --shadow-lg:
            0 16px 40px rgba(15, 23, 42, 0.10);
    }


    /* =========================================================
       PAGE
    ========================================================= */

    body {
        margin: 0;
        background: var(--background);
        color: var(--text);

        font-family:
            Arial,
            Helvetica,
            sans-serif;
    }

    .patient-history-page {
        width: 100%;
        max-width: 1200px;

        margin: 0 auto;
        padding: 30px 24px 60px;
    }


    /* =========================================================
       TOP NAVIGATION
    ========================================================= */

    .page-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;

        margin-bottom: 22px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;

        padding: 9px 13px;

        border: 1px solid var(--border);
        border-radius: var(--radius-sm);

        background: var(--surface);
        color: var(--text);

        font-size: 13px;
        font-weight: 600;
        text-decoration: none;

        box-shadow: var(--shadow-sm);

        transition:
            color 0.2s ease,
            background 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease;
    }

    .back-link:hover {
        color: var(--primary);
        border-color: #cbd5e1;
        background: var(--primary-soft);
        transform: translateX(-2px);
    }

    .back-link i {
        color: var(--primary);
    }


    /* =========================================================
       PAGE TITLE
    ========================================================= */

    .page-heading {
        margin: 0;

        color: var(--text-dark);

        font-size: 25px;
        font-weight: 700;
        line-height: 1.3;
    }

    .page-description {
        margin: 5px 0 0;

        color: var(--text-muted);
        font-size: 13px;
    }


    /* =========================================================
       PATIENT PROFILE HEADER
    ========================================================= */

    .patient-profile {
        position: relative;
        overflow: hidden;

        margin-bottom: 24px;
        padding: 24px;

        border: 1px solid var(--border);
        border-radius: var(--radius-lg);

        background: var(--surface);

        box-shadow: var(--shadow-sm);
    }

    .patient-profile::after {
        content: "";

        position: absolute;
        top: -55px;
        right: -45px;

        width: 170px;
        height: 170px;

        border-radius: 50%;

        background:
            radial-gradient(
                circle,
                rgba(37, 99, 235, 0.09),
                rgba(37, 99, 235, 0)
            );
    }

    .profile-main {
        position: relative;
        z-index: 1;

        display: flex;
        align-items: center;
        gap: 18px;
    }

    .patient-avatar {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 72px;
        height: 72px;

        flex-shrink: 0;

        border-radius: 18px;

        background:
            linear-gradient(
                135deg,
                var(--primary),
                #4f7df3
            );

        color: #fff;

        font-size: 27px;
        font-weight: 700;

        box-shadow:
            0 8px 20px rgba(37, 99, 235, 0.20);
    }

    .profile-details {
        min-width: 0;
    }

    .profile-name {
        margin: 0 0 6px;

        color: var(--text-dark);

        font-size: 24px;
        font-weight: 700;

        overflow-wrap: anywhere;
    }

    .profile-subtitle {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;

        color: var(--text-muted);
        font-size: 13px;
    }

    .profile-dot {
        color: #cbd5e1;
    }


    /* =========================================================
       PATIENT INFORMATION GRID
    ========================================================= */

    .patient-info-grid {
        position: relative;
        z-index: 1;

        display: grid;
        grid-template-columns:
            repeat(
                4,
                minmax(0, 1fr)
            );

        gap: 12px;

        margin-top: 22px;
    }

    .info-card {
        display: flex;
        align-items: flex-start;
        gap: 10px;

        min-width: 0;

        padding: 13px;

        border: 1px solid var(--border);
        border-radius: var(--radius-sm);

        background: #fafbfc;
    }

    .info-icon {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 34px;
        height: 34px;

        flex-shrink: 0;

        border-radius: 9px;

        background: var(--primary-soft);
        color: var(--primary);
    }

    .info-content {
        min-width: 0;
    }

    .info-label {
        display: block;

        margin-bottom: 3px;

        color: var(--text-muted);

        font-size: 10px;
        font-weight: 700;

        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .info-value {
        display: block;

        color: var(--text-dark);

        font-size: 13px;
        font-weight: 600;

        overflow-wrap: anywhere;
    }


    /* =========================================================
       NEXT VISIT
    ========================================================= */

    .visit-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;

        padding: 6px 9px;

        border-radius: 999px;

        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .visit-status.upcoming {
        background: var(--success-soft);
        color: #15803d;
    }

    .visit-status.none {
        background: #f3f4f6;
        color: #6b7280;
    }

    .visit-status i {
        font-size: 8px;
    }


    /* =========================================================
       HISTORY SECTION
    ========================================================= */

    .history-card {
        overflow: hidden;

        border: 1px solid var(--border);
        border-radius: var(--radius-lg);

        background: var(--surface);

        box-shadow: var(--shadow-sm);
    }

    .history-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;

        padding: 20px 22px;

        border-bottom: 1px solid var(--border);
    }

    .history-title-wrapper {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .history-title-icon {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 38px;
        height: 38px;

        border-radius: 10px;

        background: var(--primary-soft);
        color: var(--primary);
    }

    .history-title {
        margin: 0;

        color: var(--text-dark);

        font-size: 17px;
        font-weight: 700;
    }

    .history-subtitle {
        margin: 3px 0 0;

        color: var(--text-muted);
        font-size: 12px;
    }

    .history-count {
        display: inline-flex;
        align-items: center;
        gap: 5px;

        padding: 7px 11px;

        border-radius: 999px;

        background: #f3f4f6;
        color: var(--text);

        font-size: 11px;
        font-weight: 700;

        white-space: nowrap;
    }


    /* =========================================================
       HISTORY TABLE
    ========================================================= */

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .visits-table {
        width: 100%;

        border-collapse: collapse;

        min-width: 600px;
    }

    .visits-table thead {
        background: #f8fafc;
    }

    .visits-table th {
        padding: 13px 20px;

        border-bottom: 1px solid var(--border);

        color: #6b7280;

        font-size: 11px;
        font-weight: 700;

        text-align: left;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .visits-table td {
        padding: 16px 20px;

        border-bottom: 1px solid #f0f1f3;

        color: var(--text);

        font-size: 13px;
        vertical-align: middle;
    }

    .visits-table tbody tr {
        transition: background 0.2s ease;
    }

    .visits-table tbody tr:hover {
        background: #fafcff;
    }

    .visits-table tbody tr:last-child td {
        border-bottom: none;
    }


    /* =========================================================
       DATE CELL
    ========================================================= */

    .visit-date {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .date-icon {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 34px;
        height: 34px;

        border-radius: 8px;

        background: #f3f6fa;
        color: var(--primary);

        flex-shrink: 0;
    }

    .date-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .date-main {
        color: var(--text-dark);
        font-weight: 600;
    }

    .date-label {
        color: var(--text-muted);
        font-size: 10px;
    }


    /* =========================================================
       SERVICE CELL
    ========================================================= */

    .service-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .service-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;

        padding: 6px 9px;

        border: 1px solid #dbe5f5;
        border-radius: 7px;

        background: #f6f9ff;
        color: #365899;

        font-size: 11px;
        font-weight: 600;
    }

    .service-badge i {
        color: var(--primary);
        font-size: 9px;
    }

    .service-text {
        color: var(--text);
        line-height: 1.6;
    }


    /* =========================================================
       HISTORY FOOTER
    ========================================================= */

    .history-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 13px 20px;

        border-top: 1px solid var(--border);

        background: #fafbfc;
    }

    .history-summary {
        color: var(--text-muted);
        font-size: 12px;
    }

    .history-summary strong {
        color: var(--text-dark);
    }


    /* =========================================================
       EMPTY / ERROR STATE
    ========================================================= */

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        min-height: 300px;

        padding: 50px 25px;

        text-align: center;
    }

    .empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 76px;
        height: 76px;
        margin-bottom: 18px;

        border-radius: 50%;

        background: #f1f5f9;
        color: #cbd5e1;

        font-size: 30px;
    }

    .empty-state h3 {
        margin: 0 0 7px;

        color: var(--text-dark);
        font-size: 18px;
    }

    .empty-state p {
        max-width: 450px;
        margin: 0;

        color: var(--text-muted);

        font-size: 13px;
        line-height: 1.6;
    }

    .error-state .empty-icon {
        background: var(--danger-soft);
        color: #ef4444;
    }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @media (max-width: 1000px) {

        .patient-info-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }
    }


    @media (max-width: 700px) {

        .patient-history-page {
            padding: 20px 14px 45px;
        }

        .page-topbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .page-heading {
            font-size: 22px;
        }

        .patient-profile {
            padding: 18px;
        }

        .profile-main {
            align-items: flex-start;
        }

        .patient-avatar {
            width: 58px;
            height: 58px;

            border-radius: 15px;

            font-size: 22px;
        }

        .profile-name {
            font-size: 20px;
        }

        .patient-info-grid {
            grid-template-columns: 1fr;
        }

        .history-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .history-count {
            align-self: flex-start;
        }
    }


    @media (max-width: 480px) {

        .profile-main {
            flex-direction: column;
        }

        .patient-avatar {
            width: 52px;
            height: 52px;
        }

        .history-footer {
            align-items: flex-start;
            gap: 5px;
            flex-direction: column;
        }
    }
</style>


<div class="patient-history-page">


    <!-- =======================================================
         PAGE HEADER
    ======================================================== -->

    <div class="page-topbar">

        <div>
            <a
                href="/appointments"
                class="back-link"
            >
                <i class="fa-solid fa-arrow-left"></i>
                Back to Appointments
            </a>

            <h1 class="page-heading">
                Patient History
            </h1>

            <p class="page-description">
                Review patient information and previous visits.
            </p>
        </div>

    </div>


    <% if (patient) { %>


        <%
            const patientName =
                patient.patient_name || 'Unknown Patient';

            const patientInitial =
                patientName
                    .trim()
                    .charAt(0)
                    .toUpperCase();

            const visitCount =
                history ? history.length : 0;
        %>


        <!-- ===================================================
             PATIENT PROFILE
        ==================================================== -->

        <section class="patient-profile">


            <!-- Profile heading -->

            <div class="profile-main">

                <div class="patient-avatar">
                    <%= patientInitial %>
                </div>


                <div class="profile-details">

                    <h2 class="profile-name">
                        <%= patientName %>
                    </h2>

                    <div class="profile-subtitle">

                        <span>
                            <i class="fa-solid fa-phone"></i>
                            <%= formatPhone(patient.patient_phone) %>
                        </span>

                        <span class="profile-dot">
                            •
                        </span>

                        <span>
                            <i class="fa-solid fa-clock-rotate-left"></i>
                            <%= visitCount %>
                            previous
                            <%= visitCount === 1 ? 'visit' : 'visits' %>
                        </span>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 PATIENT DETAILS
            ================================================== -->

            <div class="patient-info-grid">


                <!-- Phone -->

                <div class="info-card">

                    <div class="info-icon">
                        <i class="fa-solid fa-phone"></i>
                    </div>

                    <div class="info-content">

                        <span class="info-label">
                            Phone
                        </span>

                        <span class="info-value">
                            <%= formatPhone(patient.patient_phone) %>
                        </span>

                    </div>

                </div>


                <!-- Gender -->

                <div class="info-card">

                    <div class="info-icon">
                        <i class="fa-solid fa-venus-mars"></i>
                    </div>

                    <div class="info-content">

                        <span class="info-label">
                            Gender
                        </span>

                        <span class="info-value">
                            <%= patient.gender || 'N/A' %>
                        </span>

                    </div>

                </div>


                <!-- Age -->

                <div class="info-card">

                    <div class="info-icon">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div class="info-content">

                        <span class="info-label">
                            Age
                        </span>

                        <span class="info-value">

                            <% if (
                                patient.age !== null &&
                                patient.age !== undefined &&
                                patient.age !== ''
                            ) { %>

                                <%= patient.age %> years

                            <% } else { %>

                                N/A

                            <% } %>

                        </span>

                    </div>

                </div>


                <!-- Next Visit -->

                <div class="info-card">

                    <div class="info-icon">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>

                    <div class="info-content">

                        <span class="info-label">
                            Next Visit
                        </span>


                        <% if (patient.next_visit) { %>

                            <span class="visit-status upcoming">

                                <i class="fa-solid fa-circle"></i>

                                <%= new Date(
                                    patient.next_visit
                                ).toLocaleDateString(
                                    'en-GB'
                                ) %>

                            </span>

                        <% } else { %>

                            <span class="visit-status none">

                                <i class="fa-solid fa-minus"></i>

                                Not scheduled

                            </span>

                        <% } %>

                    </div>

                </div>


                <!-- Address -->

                <div class="info-card">

                    <div class="info-icon">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>

                    <div class="info-content">

                        <span class="info-label">
                            Address
                        </span>

                        <span class="info-value">
                            <%= patient.patient_address || 'N/A' %>
                        </span>

                    </div>

                </div>


            </div>

        </section>


        <!-- ===================================================
             VISIT HISTORY
        ==================================================== -->

        <section class="history-card">


            <!-- History header -->

            <div class="history-header">

                <div class="history-title-wrapper">

                    <div class="history-title-icon">

                        <i class="fa-solid fa-clock-rotate-left"></i>

                    </div>


                    <div>

                        <h2 class="history-title">
                            Visit History
                        </h2>

                        <p class="history-subtitle">
                            Record of previous dental visits
                        </p>

                    </div>

                </div>


                <span class="history-count">

                    <i class="fa-solid fa-calendar-days"></i>

                    <%= visitCount %>
                    <%= visitCount === 1 ? 'Visit' : 'Visits' %>

                </span>

            </div>


            <% if (history && history.length > 0) { %>


                <!-- =================================================
                     HISTORY TABLE
                ================================================== -->

                <div class="table-wrapper">

                    <table class="visits-table">

                        <thead>

                            <tr>

                                <th>
                                    Visit Date
                                </th>

                                <th>
                                    Service / Treatment
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            <% history.forEach(visit => { %>

                                <%
                                    let services = [];

                                    /*
                                     * Normalize service data so the
                                     * template can display strings,
                                     * arrays, or JSON data.
                                     */
                                    if (visit.service) {

                                        try {

                                            if (
                                                typeof visit.service ===
                                                'string'
                                            ) {

                                                const parsed =
                                                    JSON.parse(
                                                        visit.service
                                                    );

                                                if (
                                                    Array.isArray(parsed)
                                                ) {

                                                    services =
                                                        parsed;

                                                } else {

                                                    services =
                                                        [parsed];

                                                }

                                            } else if (
                                                Array.isArray(
                                                    visit.service
                                                )
                                            ) {

                                                services =
                                                    visit.service;

                                            } else {

                                                services =
                                                    [visit.service];

                                            }

                                        } catch (error) {

                                            services =
                                                [visit.service];

                                        }

                                    }

                                %>


                                <tr>


                                    <!-- =================================
                                         DATE
                                    ================================== -->

                                    <td>

                                        <div class="visit-date">

                                            <div class="date-icon">

                                                <i class="fa-solid fa-calendar-day"></i>

                                            </div>


                                            <div class="date-text">

                                                <span class="date-main">

                                                    <%= new Date(
                                                        visit.visit_date
                                                    ).toLocaleDateString(
                                                        'en-GB'
                                                    ) %>

                                                </span>

                                                <span class="date-label">
                                                    Dental visit
                                                </span>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- =================================
                                         SERVICE
                                    ================================== -->

                                    <td>


                                        <% if (services.length > 0) { %>

                                            <div class="service-list">

                                                <% services.forEach(service => { %>

                                                    <%
                                                        let serviceName =
                                                            service;

                                                        /*
                                                         * Support service
                                                         * objects such as:
                                                         *
                                                         * { name: 'Cleaning' }
                                                         * { service: 'Cleaning' }
                                                         */
                                                        if (
                                                            typeof service ===
                                                            'object' &&
                                                            service !== null
                                                        ) {

                                                            serviceName =
                                                                service.name ||
                                                                service.service ||
                                                                'N/A';

                                                        }
                                                    %>

                                                    <span class="service-badge">

                                                        <i class="fa-solid fa-tooth"></i>

                                                        <%= serviceName %>

                                                    </span>

                                                <% }) %>

                                            </div>


                                        <% } else { %>

                                            <span class="service-text">
                                                No service recorded
                                            </span>

                                        <% } %>


                                    </td>


                                </tr>

                            <% }) %>


                        </tbody>

                    </table>

                </div>


                <!-- =================================================
                     HISTORY FOOTER
                ================================================== -->

                <div class="history-footer">

                    <span class="history-summary">

                        Total recorded visits:
                        <strong>
                            <%= visitCount %>
                        </strong>

                    </span>


                    <span class="history-summary">

                        <i class="fa-solid fa-shield-heart"></i>

                        Shine Dental Surgery

                    </span>

                </div>


            <% } else { %>


                <!-- =================================================
                     EMPTY HISTORY
                ================================================== -->

                <div class="empty-state">

                    <div class="empty-icon">

                        <i class="fa-solid fa-calendar-xmark"></i>

                    </div>

                    <h3>
                        No Visit History
                    </h3>

                    <p>
                        There are no previous dental visits recorded
                        for this patient yet.
                    </p>

                </div>


            <% } %>


        </section>


    <% } else { %>


        <!-- =======================================================
             PATIENT NOT FOUND
        ======================================================== -->

        <section class="history-card">

            <div class="empty-state error-state">

                <div class="empty-icon">

                    <i class="fa-solid fa-user-slash"></i>

                </div>

                <h3>
                    Patient Not Found
                </h3>

                <p>
                    <%= message || 'The requested patient record could not be found.' %>
                </p>

            </div>

        </section>

    <% } %>

</div>