<style>
    .labwork-page { max-width: 1200px; margin: 20px auto; padding: 20px; }
    .labwork-header, .labwork-panel { background: #fff; border: 1px solid #ddd; border-radius: 6px; padding: 24px; }
    .labwork-header { border-top: 3px solid #007bff; margin-bottom: 20px; }
    .labwork-header h1 { margin: 0 0 6px; color: #333; }
    .labwork-header p { margin: 0; color: #666; }
    .labwork-form { display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px; align-items: end; margin-bottom: 24px; }
    .labwork-form label { display: block; color: #555; font-size: 13px; font-weight: 600; margin-bottom: 5px; }
    .labwork-form input, .labwork-form select { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; }
    .labwork-form button { padding: 10px 16px; border: 0; border-radius: 4px; background: #007bff; color: #fff; cursor: pointer; font-weight: 600; }
    .labwork-form button:hover { background: #0056b3; }
    .labwork-summary { display: flex; justify-content: space-between; align-items: center; background: #f1f8ff; border: 1px solid #cfe5ff; padding: 14px 18px; margin-bottom: 20px; }
    .labwork-summary strong { color: #0056b3; font-size: 20px; }
    .labwork-table { width: 100%; border-collapse: collapse; }
    .labwork-table th, .labwork-table td { padding: 12px 10px; border-bottom: 1px solid #eee; text-align: left; }
    .labwork-table th { background: #f8f9fa; color: #555; font-size: 13px; }
    .status { display: inline-block; padding: 4px 9px; border-radius: 12px; font-size: 12px; font-weight: 600; text-transform: capitalize; }
    .status-paid { background: #dff5e5; color: #18753a; }
    .status-pending { background: #fff1d6; color: #9a6500; }
    .delete-labwork { border: 0; background: transparent; color: #dc3545; cursor: pointer; font-size: 16px; }
    .labwork-status-select { padding: 5px 8px; border: 1px solid #ccc; border-radius: 4px; }
    .empty-state { color: #777; padding: 28px 0; text-align: center; }
    .alert { display: none; padding: 10px 14px; margin-bottom: 16px; border-radius: 4px; }
    .alert-success { display: block; background: #dff5e5; color: #18753a; }
    .alert-error { display: block; background: #fde2e2; color: #a32020; }
    @media (max-width: 800px) {
        .labwork-form { grid-template-columns: repeat(2, 1fr); }
        .labwork-table { min-width: 680px; }
        .table-scroll { overflow-x: auto; }
    }
</style>

<div class="labwork-page">
    <div class="labwork-header">
        <h1><i class="fas fa-flask"></i> Lab Work</h1>
        <p>Track laboratory work, units, prices, and payment status.</p>
    </div>

    <div id="labworkAlert" class="alert"></div>

    <div class="labwork-panel">
        <form id="labworkForm" class="labwork-form">
            <div>
                <label for="workType">Type of work *</label>
                <input id="workType" name="work_type" type="text" placeholder="e.g. Crown" required>
            </div>
            <div>
                <label for="workUnit">Unit *</label>
                <input id="workUnit" name="unit" type="text" placeholder="e.g. 1 tooth" required>
            </div>
            <div>
                <label for="workPrice">Price (UGX) *</label>
                <input id="workPrice" name="price" type="number" min="0.01" step="0.01" required>
            </div>
            <div>
                <label for="workStatus">Status *</label>
                <select id="workStatus" name="status" required>
                    <option value="pending">Pending</option>
                    <option value="paid">Paid</option>
                </select>
            </div>
            <div>
                <label for="workDate">Date created *</label>
                <input id="workDate" name="created_date" type="date" value="<%= selectedDate %>" required>
            </div>
            <button id="labworkSubmit" type="submit"><i class="fas fa-plus"></i> Add Lab Work</button>
        </form>

        <div class="labwork-summary">
            <span>Lab work total for <strong><%= selectedDate %></strong></span>
            <strong>UGX <%= Number(totalLabWork || 0).toLocaleString('en-US', {minimumFractionDigits: 2}) %></strong>
        </div>

        <div class="table-scroll">
            <% if (labWork && labWork.length) { %>
                <table class="labwork-table">
                    <thead>
                        <tr>
                            <th>Type of work</th>
                            <th>Unit</th>
                            <th>Price (UGX)</th>
                            <th>Status</th>
                            <th>Date created</th>
                            <th>Date cleared</th>
                            <% if (user && user.usertype === 'admin') { %><th>Update</th><% } %>
                        </tr>
                    </thead>
                    <tbody>
                        <% labWork.forEach(item => { %>
                            <tr>
                                <td><%= item.work_type %></td>
                                <td><%= item.unit %></td>
                                <td><strong><%= Number(item.price).toLocaleString('en-US', {minimumFractionDigits: 2}) %></strong></td>
                                <td><span class="status status-<%= item.status %>"><%= item.status %></span></td>
                                <td><%= new Date(item.created_date).toLocaleDateString('en-GB') %></td>
                                <td><%= item.cleared_date ? new Date(item.cleared_date).toLocaleDateString('en-GB') : '-' %></td>
                                <% if (user && user.usertype === 'admin') { %>
                                    <td>
                                        <select class="labwork-status-select" onchange="updateLabWorkStatus(<%= item.id %>, this.value)">
                                            <option value="pending" <%= item.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                            <option value="paid" <%= item.status === 'paid' ? 'selected' : '' %>>Paid</option>
                                        </select>
                                    </td>
                                <% } %>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <div class="empty-state">No lab work recorded for <%= selectedDate %>.</div>
            <% } %>
        </div>
    </div>
</div>

<script>
    const labworkForm = document.getElementById('labworkForm');
    const labworkAlert = document.getElementById('labworkAlert');

    function showLabworkAlert(message, type) {
        labworkAlert.textContent = message;
        labworkAlert.className = `alert alert-${type}`;
    }

    labworkForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const response = await fetch('/labwork', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(labworkForm)))
        });
        const result = await response.json();
        if (!response.ok) {
            showLabworkAlert(result.message || 'Error adding lab work', 'error');
            return;
        }
        showLabworkAlert(result.message, 'success');
        setTimeout(() => window.location.reload(), 600);
    });

    async function updateLabWorkStatus(id, status) {
        const response = await fetch(`/labwork/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status })
        });
        const result = await response.json();
        if (!response.ok) {
            showLabworkAlert(result.message || 'Error updating lab work', 'error');
            return;
        }
        window.location.reload();
    }

</script>
