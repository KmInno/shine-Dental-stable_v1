<!-- =========================================================
     PATIENT RECORD MODAL
========================================================= -->

<div
    id="patientModal"
    class="modal"
>

    <div class="modal-content">


        <!-- Modal Header -->

        <div class="modal-header">

            <div class="modal-title-wrap">

                <div class="modal-icon">

                    <i class="fa-solid fa-user-check"></i>

                </div>


