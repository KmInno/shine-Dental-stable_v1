                    </h2>

                    <p>
                        An existing patient matches this information.
                    </p>

                </div>

            </div>


            <span
                class="close"
                id="closePatientModal"
                aria-label="Close"
            >

                <i class="fa-solid fa-xmark"></i>

            </span>

        </div>


        <!-- Modal Body -->

        <div class="modal-body">

            <div class="patient-record-info">


                <div class="record-row">

                    <span class="record-label">
                        Name
                    </span>

                    <span
                        id="modalPatientName"
                        class="record-value"
                    ></span>

                </div>


                <div class="record-row">

                    <span class="record-label">
                        Patient ID
                    </span>

                    <span
                        id="modalPatientId"
                        class="record-value patient-id"
                    ></span>

                </div>


                <div class="record-row">

                    <span class="record-label">
                        Total Receipts
                    </span>

                    <span
                        id="modalReceiptCount"
                        class="record-value"
                    ></span>

                </div>


            </div>

        </div>


