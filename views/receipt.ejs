<script>
    /* =========================================================
       1. GLOBAL STATE
    ========================================================= */

    let currentPatient = null;


    /* =========================================================
       2. DOM REFERENCES
    ========================================================= */

    const receiptForm =
        document.getElementById('receiptForm');

    const servicesContainer =
        document.getElementById('servicesContainer');

    const patientFieldsContainer =
        document.getElementById(
            'patientFieldsContainer'
        );

    const patientInfoDisplay =
        document.getElementById(
            'patientInfoDisplay'
        );

    const pageTitle =
        document.getElementById('pageTitle');

    const totalInput =
        document.getElementById('total');

    const amountPaidInput =
        document.getElementById('amount_paid');

    const balanceInput =
        document.getElementById('balance');

    const serviceHiddenInput =
        document.getElementById('service');

    const usePatientIdInput =
        document.getElementById(
            'use_patient_id'
        );

    const forceNewIdInput =
        document.getElementById(
            'force_new_id'
        );

    const patientModal =
        document.getElementById(
            'patientModal'
        );

    const lookupPatientIdInput =
        document.getElementById(
            'lookupPatientId'
        );

    const lookupResult =
        document.getElementById(
            'lookupResult'
        );

    const displayTotal =
        document.getElementById(
            'displayTotal'
        );

    const displayBalance =
        document.getElementById(
            'displayBalance'
        );


    /* =========================================================
       3. MONEY FORMATTER
    ========================================================= */

    function formatMoney(value) {

        return Number(value || 0)
            .toLocaleString('en-US');
    }


    /* =========================================================
       4. PHONE NUMBER
    ========================================================= */

    document
        .getElementById('patientPhone')
        .addEventListener(
            'blur',
            function () {

                const value =
                    this.value.trim();

                if (value.startsWith('0')) {

                    this.value =
                        '+256' +
                        value.substring(1);

                }

            }
        );


    /* =========================================================
       5. ADD SERVICE
    ========================================================= */

    function addService() {

        const row =
            document.createElement('tr');


        row.innerHTML = `
            <td>
                <input
                    type="text"
                    class="service-input service-name"
                    placeholder="Service name"
                    required
                >
            </td>

            <td>
                <input
                    type="number"
                    class="service-input service-price price"
                    value="0"
                    min="0"
                    placeholder="0"
                >
            </td>

            <td>
                <input
                    type="number"
                    class="service-input service-qty qty"
                    value="1"
                    min="1"
                    placeholder="1"
                >
            </td>

            <td>
                <input
                    type="number"
                    class="service-input service-amount amount"
                    value="0"
                    readonly
                >
            </td>

            <td>
                <button
                    type="button"
                    class="remove-service-btn"
                    title="Remove service"
                    aria-label="Remove service"
                >
                    <i class="fa-solid fa-trash"></i>
                </button>
            </td>
        `;


        servicesContainer.appendChild(row);


        /* Recalculate on input */

        row
            .querySelectorAll('input')
            .forEach(input => {

                input.addEventListener(
                    'input',
                    calculateTotal
                );

            });


        /* Remove row */

        row
            .querySelector(
                '.remove-service-btn'
            )
            .addEventListener(
                'click',
                function () {

                    row.remove();

                    calculateTotal();

                }
            );


        calculateTotal();
    }


    /* =========================================================
       6. CALCULATE TOTAL
    ========================================================= */

    function calculateTotal() {

        let total = 0;


        document
            .querySelectorAll(
                '#servicesContainer tr'
            )
            .forEach(row => {

                const price =
                    parseFloat(
                        row.querySelector(
                            '.price'
                        ).value
                    ) || 0;


                const qty =
                    parseFloat(
                        row.querySelector(
                            '.qty'
                        ).value
                    ) || 1;


                const amount =
                    price * qty;


                row.querySelector(
                    '.amount'
                ).value =
                    amount;


                total += amount;

            });


        totalInput.value =
            total;


        displayTotal.textContent =
            `UGX ${formatMoney(total)}`;


        calculateBalance();
    }


    /* =========================================================
       7. CALCULATE BALANCE
    ========================================================= */

    function calculateBalance() {

        const total =
            parseFloat(
                totalInput.value
            ) || 0;


        const paid =
            parseFloat(
                amountPaidInput.value
            ) || 0;


        const balance =
            total - paid;


        balanceInput.value =
            balance;


        displayBalance.textContent =
            `UGX ${formatMoney(balance)}`;


        /*
         * Visual indication for overpayment,
         * remaining balance, or fully paid.
         */

        if (balance > 0) {

            displayBalance.style.color =
                '#dc2626';

        } else if (balance < 0) {

            displayBalance.style.color =
                '#2563eb';

        } else {

            displayBalance.style.color =
                '#16a34a';
        }
    }


    amountPaidInput.addEventListener(
        'input',
        calculateBalance
    );


    /* =========================================================
       8. PREPARE SERVICES BEFORE SUBMISSION
    ========================================================= */

    receiptForm.addEventListener(
        'submit',
        function () {

            const services = [];


            document
                .querySelectorAll(
                    '#servicesContainer tr'
                )
                .forEach(row => {

                    services.push({

                        name:
                            row.querySelector(
                                '.service-name'
                            ).value,

                        qty:
                            row.querySelector(
                                '.qty'
                            ).value,

                        amount:
                            row.querySelector(
                                '.amount'
                            ).value

                    });

                });


            serviceHiddenInput.value =
                JSON.stringify(
                    services
                );
        }
    );


    /* =========================================================
       9. DUPLICATE PATIENT MODAL
    ========================================================= */

    function handleDuplicateName(patients) {

        if (
            !patients ||
            patients.length === 0
        ) {
            return;
        }


        currentPatient =
            patients[0];


        document.getElementById(
            'modalPatientName'
        ).textContent =
            currentPatient.patient_name ||
            'N/A';


        document.getElementById(
            'modalPatientId'
        ).textContent =
            currentPatient.patient_id ||
            'N/A';


        document.getElementById(
            'modalReceiptCount'
        ).textContent =
            currentPatient.receipt_count ||
            0;


        patientModal.style.display =
            'block';
    }


    function closePatientModal() {

        patientModal.style.display =
            'none';

        currentPatient = null;
    }


    /* =========================================================
       10. USE EXISTING PATIENT
    ========================================================= */

    function useExistingPatient() {

        if (
            !currentPatient ||
            !currentPatient.patient_id
        ) {
            return;
        }


        document.querySelector(
            'input[name="patient_name"]'
        ).value =
            currentPatient.patient_name ||
            '';


        document.querySelector(
            'input[name="patient_phone"]'
        ).value =
            currentPatient.patient_phone ||
            '';


        document.querySelector(
            'input[name="patient_address"]'
        ).value =
            currentPatient.patient_address ||
            '';


        document.querySelector(
            'select[name="patient_gender"]'
        ).value =
            currentPatient.gender ||
            '';


        document.querySelector(
            'input[name="patient_age"]'
        ).value =
            currentPatient.age ||
            '';


        patientFieldsContainer.style.display =
            'none';


        patientInfoDisplay.style.display =
            'block';


        document.getElementById(
            'displayPatientName'
        ).textContent =
            currentPatient.patient_name;


        document.getElementById(
            'displayPatientPhone'
        ).textContent =
            currentPatient.patient_phone;


        pageTitle.textContent =
            'Add Receipt to Existing Patient';


        usePatientIdInput.value =
            currentPatient.patient_id;


        closePatientModal();
    }


    /* =========================================================
       11. CREATE NEW PATIENT
    ========================================================= */

    function createNewPatient() {

        forceNewIdInput.value =
            'true';


        closePatientModal();
    }


    /* =========================================================
       12. PATIENT LOOKUP
    ========================================================= */

    async function lookupPatientId() {

        const patientId =
            lookupPatientIdInput.value.trim();


        if (!patientId) {

            showLookupResult(
                'Please enter a patient ID.',
                'error'
            );

            return;
        }


        try {

            const response =
                await fetch(
                    '/receipt/validate-id',
                    {
                        method: 'POST',

                        headers: {
                            'Content-Type':
                                'application/json'
                        },

                        body: JSON.stringify({
                            patient_id:
                                patientId
                        })
                    }
                );


            const data =
                await response.json();


            if (!data.success) {

                showLookupResult(
                    data.message ||
                    'Error validating patient ID.',
                    'error'
                );

                return;
            }


            /* =============================================
               PATIENT FOUND
            ============================================== */

            if (
                data.exists &&
                data.patientData
            ) {

                const formattedId =
                    data.formattedId;


                showLookupResult(
                    `
                    <strong>
                        ✓ Patient found
                    </strong>
                    <br>
                    ${data.patientData.patient_name}
                    <br>
                    Phone:
                    ${data.patientData.patient_phone}
                    <br>
                    Patient ID:
                    <strong>${formattedId}</strong>
                    `,
                    'success'
                );


                setTimeout(() => {

                    usePatientIdInput.value =
                        formattedId;


                    document.querySelector(
                        'input[name="patient_name"]'
                    ).value =
                        data.patientData.patient_name;


                    document.querySelector(
                        'input[name="patient_phone"]'
                    ).value =
                        data.patientData.patient_phone;


                    patientFieldsContainer
                        .style.display =
                        'none';


                    patientInfoDisplay
                        .style.display =
                        'block';


                    document.getElementById(
                        'displayPatientName'
                    ).textContent =
                        'Patient: ' +
                        data.patientData
                            .patient_name;


                    document.getElementById(
                        'displayPatientPhone'
                    ).textContent =
                        'Phone: ' +
                        data.patientData
                            .patient_phone;


                    pageTitle.textContent =
                        'Add Receipt to Existing Patient';


                    document
                        .querySelector(
                            '.receipt-page'
                        )
                        .scrollIntoView({
                            behavior:
                                'smooth'
                        });

                }, 500);


                return;
            }


            /* =============================================
               NOT FOUND
            ============================================== */

            showLookupResult(
                `
                ID Reformatted:
                <strong>${data.formattedId}</strong>
                <br>
                No existing patient was found.
                This can be created as a new patient.
                `,
                'info'
            );

        } catch (error) {

            console.error(
                'Patient lookup error:',
                error
            );


            showLookupResult(
                'Unable to look up patient. Please try again.',
                'error'
            );
        }
    }


    /* =========================================================
       13. LOOKUP RESULT
    ========================================================= */

    function showLookupResult(
        message,
        type
    ) {

        lookupResult.innerHTML =
            message;


        lookupResult.style.display =
            'block';


        const styles = {

            success: {
                border:
                    '#16a34a',
                background:
                    '#ecfdf3',
                color:
                    '#166534'
            },

            error: {
                border:
                    '#dc2626',
                background:
                    '#fef2f2',
                color:
                    '#991b1b'
            },

            info: {
                border:
                    '#2563eb',
                background:
                    '#eff6ff',
                color:
                    '#1e40af'
            }

        };


        const selected =
            styles[type] ||
            styles.info;


        lookupResult.style.borderLeft =
            `4px solid ${selected.border}`;


        lookupResult.style.backgroundColor =
            selected.background;


        lookupResult.style.color =
            selected.color;
    }


    /* =========================================================
       14. URL PATIENT INFORMATION
    ========================================================= */

    function loadPatientFromUrl() {

        const params =
            new URLSearchParams(
                window.location.search
            );


        const patientName =
            params.get('patient');


        const patientPhone =
            params.get('phone');


        if (
            !patientName ||
            !patientPhone
        ) {
            return;
        }


        patientFieldsContainer
            .style.display =
            'none';


        patientInfoDisplay
            .style.display =
            'block';


        document.getElementById(
            'displayPatientName'
        ).textContent =
            'Patient: ' +
            patientName;


        document.getElementById(
            'displayPatientPhone'
        ).textContent =
            'Phone: ' +
            patientPhone;


        pageTitle.textContent =
            'Add Receipt to Existing Patient';


        document.querySelector(
            'input[name="patient_name"]'
        ).value =
            patientName;


        document.querySelector(
            'input[name="patient_phone"]'
        ).value =
            patientPhone;
    }


    /* =========================================================
       15. DUPLICATE NAME CHECK
    ========================================================= */

    async function checkPatientName() {

        const patientName =
            this.value.trim();


        if (!patientName) {
            return;
        }


        /*
         * Don't check duplicates when
         * using an existing patient.
         */
        if (
            patientFieldsContainer
                .style.display ===
            'none'
        ) {
            return;
        }


        try {

            const response =
                await fetch(
                    '/receipt/check-name',
                    {
                        method: 'POST',

                        headers: {
                            'Content-Type':
                                'application/json'
                        },

                        body: JSON.stringify({
                            patient_name:
                                patientName
                        })
                    }
                );


            const data =
                await response.json();


            if (
                data.success &&
                data.exists &&
                data.patients &&
                data.patients.length > 0
            ) {

                handleDuplicateName(
                    data.patients
                );
            }

        } catch (error) {

            console.error(
                'Duplicate patient check error:',
                error
            );
        }
    }


    /* =========================================================
       16. EVENT LISTENERS
    ========================================================= */

    document
        .getElementById(
            'useExistingBtn'
        )
        .addEventListener(
            'click',
            useExistingPatient
        );


    document
        .getElementById(
            'createNewBtn'
        )
        .addEventListener(
            'click',
            createNewPatient
        );


    document
        .getElementById(
            'closePatientModal'
        )
        .addEventListener(
            'click',
            closePatientModal
        );


    document
        .getElementById(
            'addServiceBtn'
        )
        .addEventListener(
            'click',
            addService
        );


    document
        .getElementById(
            'lookupPatientBtn'
        )
        .addEventListener(
            'click',
            lookupPatientId
        );


    document
        .getElementById(
            'patientName'
        )
        .addEventListener(
            'blur',
            checkPatientName
        );


    /* =========================================================
       17. MODAL CLOSE
    ========================================================= */

    document.addEventListener(
        'click',
        function (event) {

            if (
                event.target ===
                patientModal
            ) {

                closePatientModal();
            }
        }
    );


    document.addEventListener(
        'keydown',
        function (event) {

            if (
                event.key ===
                'Escape'
            ) {

                closePatientModal();
            }
        }
    );


    /* =========================================================
       18. INITIALIZE
    ========================================================= */

    document.addEventListener(
        'DOMContentLoaded',
        function () {

            /* Start with one service */
            addService();


            /* Load patient from URL */
            loadPatientFromUrl();


            /* Initialize totals */
            calculateTotal();

        }
    );
</script>
