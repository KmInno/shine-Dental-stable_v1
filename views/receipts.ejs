
<!-- =========================================================
     SHINE DENTAL - RECEIPTS MANAGEMENT
========================================================= -->

<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
>


<style>
    /* =========================================================
       DESIGN SYSTEM
    ========================================================= */

    :root {
        --primary: #589f14;
        --primary-dark: #467f10;
        --primary-soft: #eef7e6;

        --blue: #2563eb;
        --blue-soft: #eff6ff;

        --success: #16a34a;
        --success-soft: #ecfdf3;

        --danger: #dc2626;
        --danger-soft: #fef2f2;

        --warning: #d97706;
        --warning-soft: #fffbeb;

        --text-dark: #1f2937;
        --text: #4b5563;
        --text-muted: #9ca3af;

        --border: #e5e7eb;
        --background: #f5f7fb;
        --surface: #ffffff;

        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;

        --shadow-sm:
            0 2px 8px rgba(15, 23, 42, 0.05);

        --shadow-md:
            0 8px 24px rgba(15, 23, 42, 0.08);

        --shadow-lg:
            0 16px 40px rgba(15, 23, 42, 0.10);
    }


    /* =========================================================
       PAGE
    ========================================================= */

    body {
        margin: 0;

        background: var(--background);
        color: var(--text);

        font-family:
            Arial,
            Helvetica,
            sans-serif;
    }

    .receipts-page {
        width: 100%;
        max-width: 1450px;

        margin: 0 auto;
        padding: 30px 24px 60px;
    }


    /* =========================================================
       PAGE HEADER
    ========================================================= */

    .page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;

        margin-bottom: 25px;
    }

    .header-main {
        min-width: 0;
    }

    .page-title {
        display: flex;
        align-items: center;
        gap: 12px;

        margin: 0 0 7px;

        color: var(--text-dark);

        font-size: 28px;
        font-weight: 700;
        line-height: 1.2;
    }

    .page-title i {
        color: var(--primary);
    }

    .page-subtitle {
        margin: 0;

        color: var(--text-muted);

        font-size: 14px;
        line-height: 1.6;
    }

    .receipt-counter {
        display: inline-flex;
        align-items: center;
        gap: 8px;

        padding: 10px 14px;

        border: 1px solid var(--border);
        border-radius: 999px;

        background: var(--surface);
        color: var(--text);

        font-size: 13px;
        font-weight: 600;

        box-shadow: var(--shadow-sm);

        white-space: nowrap;
    }

    .receipt-counter i {
        color: var(--primary);
    }


    /* =========================================================
       TOOLBAR
    ========================================================= */

    .receipt-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;

        margin-bottom: 20px;
        padding: 12px;

        border: 1px solid var(--border);
        border-radius: var(--radius-md);

        background: var(--surface);

        box-shadow: var(--shadow-sm);
    }


    /* =========================================================
       SEARCH
    ========================================================= */

    .search-form {
        display: flex;
        align-items: center;
        gap: 8px;

        width: 100%;
        max-width: 650px;
    }

    .search-wrapper {
        position: relative;

        width: 100%;
    }

    .search-wrapper i {
        position: absolute;
        left: 13px;
        top: 50%;

        color: var(--text-muted);

        font-size: 14px;

        transform: translateY(-50%);
        pointer-events: none;
    }

    .search-input {
        width: 100%;
        min-height: 42px;

        padding: 10px 14px 10px 38px;

        border: 1px solid #d8dde6;
        border-radius: var(--radius-sm);

        background: #fff;
        color: var(--text-dark);

        font-family: inherit;
        font-size: 13px;

        outline: none;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    .search-input:focus {
        border-color: var(--primary);

        box-shadow:
            0 0 0 3px rgba(88, 159, 20, 0.10);
    }

    .search-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;

        min-height: 42px;

        padding: 10px 17px;

        border: none;
        border-radius: var(--radius-sm);

        background: var(--primary);
        color: #fff;

        font-family: inherit;
        font-size: 13px;
        font-weight: 700;

        cursor: pointer;

        transition:
            background 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .search-btn:hover {
        background: var(--primary-dark);

        transform: translateY(-1px);

        box-shadow:
            0 5px 12px rgba(88, 159, 20, 0.20);
    }


    /* =========================================================
       NEW RECEIPT BUTTON
    ========================================================= */

    .new-receipt-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;

        min-height: 42px;

        padding: 10px 17px;

        border-radius: var(--radius-sm);

        background: var(--primary);
        color: #fff;

        font-size: 13px;
        font-weight: 700;

        text-decoration: none;

        white-space: nowrap;

        transition:
            background 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .new-receipt-btn:hover {
        background: var(--primary-dark);

        color: #fff;

        transform: translateY(-1px);

        box-shadow:
            0 5px 12px rgba(88, 159, 20, 0.20);
    }


    /* =========================================================
       SEARCH STATE
    ========================================================= */

    .search-state {
        margin-bottom: 18px;

        color: var(--text-muted);

        font-size: 13px;
    }

    .search-state strong {
        color: var(--text-dark);
    }

    .clear-search {
        margin-left: 8px;

        color: var(--primary);
        font-weight: 600;
        text-decoration: none;
    }

    .clear-search:hover {
        text-decoration: underline;
    }


    /* =========================================================
       TABLE CARD
    ========================================================= */

    .receipts-card {
        overflow: hidden;

        border: 1px solid var(--border);
        border-radius: var(--radius-lg);

        background: var(--surface);

        box-shadow: var(--shadow-sm);
    }


    /* =========================================================
       TABLE HEADER
    ========================================================= */

    .table-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;

        padding: 18px 20px;

        border-bottom: 1px solid var(--border);
    }

    .table-title {
        display: flex;
        align-items: center;
        gap: 10px;

        margin: 0;

        color: var(--text-dark);

        font-size: 16px;
        font-weight: 700;
    }

    .table-title i {
        color: var(--primary);
    }

    .table-count {
        padding: 5px 9px;

        border-radius: 999px;

        background: var(--primary-soft);
        color: var(--primary-dark);

        font-size: 11px;
        font-weight: 700;
    }


    /* =========================================================
       TABLE WRAPPER
    ========================================================= */

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .receipts-table {
        width: 100%;
        min-width: 1050px;

        border-collapse: collapse;
    }

    .receipts-table thead {
        background: #f8fafc;
    }

    .receipts-table th {
        padding: 13px 16px;

        border-bottom: 1px solid var(--border);

        color: #6b7280;

        font-size: 10px;
        font-weight: 700;

        text-align: left;

        text-transform: uppercase;
        letter-spacing: 0.5px;

        white-space: nowrap;
    }

    .receipts-table td {
        padding: 15px 16px;

        border-bottom: 1px solid #f0f1f3;

        color: var(--text);

        font-size: 13px;
        vertical-align: middle;
    }

    .receipts-table tbody tr {
        transition:
            background 0.2s ease;
    }

    .receipts-table tbody tr:hover {
        background: #fafcff;
    }

    .receipts-table tbody tr:last-child td {
        border-bottom: none;
    }


    /* =========================================================
       RECEIPT ID
    ========================================================= */

    .receipt-id {
        display: inline-flex;
        align-items: center;
        gap: 6px;

        padding: 6px 9px;

        border-radius: 7px;

        background: #f3f4f6;
        color: var(--text-dark);

        font-size: 11px;
        font-weight: 700;

        white-space: nowrap;
    }

    .receipt-id i {
        color: var(--primary);
    }


    /* =========================================================
       DATE
    ========================================================= */

    .date-cell {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .date-main {
        color: var(--text-dark);
        font-weight: 600;
    }

    .date-secondary {
        color: var(--text-muted);
        font-size: 10px;
    }


    /* =========================================================
       PATIENT
    ========================================================= */

    .patient-cell {
        display: flex;
        align-items: center;
        gap: 10px;

        min-width: 180px;
    }

    .patient-avatar {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 38px;
        height: 38px;

        flex-shrink: 0;

        border-radius: 50%;

        background: var(--primary-soft);
        color: var(--primary-dark);

        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .patient-details {
        display: flex;
        flex-direction: column;
        gap: 3px;

        min-width: 0;
    }

    .patient-name-link {
        color: var(--text-dark);

        font-size: 13px;
        font-weight: 700;

        text-decoration: none;

        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .patient-name-link:hover {
        color: var(--primary);
    }

    .patient-label {
        color: var(--text-muted);
        font-size: 10px;
    }


    /* =========================================================
       PHONE / WHATSAPP
    ========================================================= */

    .phone-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        color: var(--text-dark);

        font-size: 12px;
        text-decoration: none;

        white-space: nowrap;

        transition: color 0.2s ease;
    }

    .phone-link:hover {
        color: #1da851;
    }

    .whatsapp-icon {
        color: #25d366;
        font-size: 17px;
    }


    /* =========================================================
       MONEY
    ========================================================= */

    .amount {
        color: var(--text-dark);

        font-weight: 700;

        white-space: nowrap;
    }

    .currency {
        color: var(--text-muted);
        font-size: 10px;
        font-weight: 600;
    }


    /* =========================================================
       PAYMENT METHOD
    ========================================================= */

    .payment-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;

        padding: 6px 9px;

        border-radius: 7px;

        background: #f3f4f6;
        color: #4b5563;

        font-size: 10px;
        font-weight: 700;

        text-transform: capitalize;
        white-space: nowrap;
    }

    .payment-badge.cash {
        background: var(--success-soft);
        color: #15803d;
    }

    .payment-badge.mobile {
        background: var(--blue-soft);
        color: #1d4ed8;
    }

    .payment-badge.visa {
        background: #fff7e6;
        color: #b77900;
    }


    /* =========================================================
       BALANCE
    ========================================================= */

    .balance-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;

        padding: 6px 9px;

        border-radius: 7px;

        font-size: 11px;
        font-weight: 700;

        white-space: nowrap;
    }

    .balance-badge.pending {
        background: var(--danger-soft);
        color: var(--danger);
    }

    .balance-badge.paid {
        background: var(--success-soft);
        color: var(--success);
    }


    /* =========================================================
       ACTIONS
    ========================================================= */

    .action-group {
        display: flex;
        align-items: center;
        gap: 6px;

        white-space: nowrap;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;

        min-height: 32px;

        padding: 7px 10px;

        border: 1px solid transparent;
        border-radius: 7px;

        font-size: 11px;
        font-weight: 700;

        text-decoration: none;
        cursor: pointer;

        transition:
            background 0.2s ease,
            border-color 0.2s ease,
            color 0.2s ease,
            transform 0.2s ease;
    }

    .action-btn:hover {
        transform: translateY(-1px);
    }

    .history-btn {
        border-color: #dbe5f5;
        background: var(--blue-soft);
        color: var(--blue);
    }

    .history-btn:hover {
        border-color: #bfd0f0;
        background: #e5efff;
        color: #1d4ed8;
    }

    .delete-btn {
        border-color: #f4cccc;
        background: var(--danger-soft);
        color: var(--danger);
    }

    .delete-btn:hover {
        border-color: #efaaaa;
        background: #fee2e2;
        color: #b91c1c;
    }


    /* =========================================================
       TABLE FOOTER
    ========================================================= */

    .table-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;

        padding: 14px 20px;

        border-top: 1px solid var(--border);

        background: #fafbfc;
    }

    .results-info {
        color: var(--text-muted);
        font-size: 12px;
    }

    .results-info strong {
        color: var(--text-dark);
    }


    /* =========================================================
       PAGINATION
    ========================================================= */

    .pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;

        margin-top: 20px;
    }

    .page-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;

        min-height: 38px;

        padding: 8px 13px;

        border: 1px solid var(--border);
        border-radius: 8px;

        background: var(--surface);
        color: var(--text);

        font-size: 12px;
        font-weight: 600;

        text-decoration: none;

        transition:
            background 0.2s ease,
            border-color 0.2s ease,
            color 0.2s ease;
    }

    .page-link:hover {
        border-color: #cbd5e1;
        background: #f8fafc;
        color: var(--primary);
    }

    .page-info {
        padding: 8px 12px;

        color: var(--text-muted);

        font-size: 12px;
        font-weight: 600;
    }


    /* =========================================================
       EMPTY STATE
    ========================================================= */

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        min-height: 330px;
        padding: 50px 20px;

        text-align: center;
    }

    .empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 78px;
        height: 78px;
        margin-bottom: 18px;

        border-radius: 50%;

        background: #f1f5f9;
        color: #cbd5e1;

        font-size: 32px;
    }

    .empty-state h3 {
        margin: 0 0 7px;

        color: var(--text-dark);
        font-size: 18px;
    }

    .empty-state p {
        max-width: 420px;

        margin: 0;

        color: var(--text-muted);

        font-size: 13px;
        line-height: 1.6;
    }


    /* =========================================================
       SCROLL TO BOTTOM
    ========================================================= */

    #scrollToBottomBtn {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 1000;

        display: none;
        align-items: center;
        justify-content: center;

        width: 48px;
        height: 48px;

        border: none;
        border-radius: 50%;

        background: var(--primary);
        color: #fff;

        font-size: 16px;

        cursor: pointer;

        box-shadow:
            0 8px 20px rgba(88, 159, 20, 0.25);

        transition:
            background 0.2s ease,
            transform 0.2s ease;
    }

    #scrollToBottomBtn:hover {
        background: var(--primary-dark);
        transform: translateY(-2px);
    }

    #scrollToBottomBtn:active {
        transform: scale(0.94);
    }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @media (max-width: 900px) {

        .receipts-page {
            padding: 22px 15px 50px;
        }

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .receipt-counter {
            align-self: flex-start;
        }

        .receipt-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .search-form {
            max-width: none;
        }

        .new-receipt-btn {
            width: 100%;
        }
    }


    @media (max-width: 600px) {

        .page-title {
            font-size: 23px;
        }

        .search-form {
            align-items: stretch;
            flex-direction: column;
        }

        .search-btn {
            width: 100%;
        }

        .table-header {
            padding: 15px 16px;
        }

        .table-footer {
            padding: 12px 16px;
        }

        .pagination {
            flex-wrap: wrap;
        }

        #scrollToBottomBtn {
            right: 16px;
            bottom: 16px;
        }
    }
</style>


<div class="receipts-page">


    <!-- =======================================================
         PAGE HEADER
    ======================================================== -->

    <header class="page-header">

        <div class="header-main">

            <h1 class="page-title">

                <i class="fa-solid fa-receipt"></i>

                <%= title %>

            </h1>

            <p class="page-subtitle">

                Manage patient receipts, payments,
                balances, and billing history.

            </p>

        </div>


        <div class="receipt-counter">

            <i class="fa-solid fa-file-invoice"></i>

            <strong>
                <%= receipts ? receipts.length : 0 %>
            </strong>

            <span>
                Receipt<%= receipts && receipts.length === 1 ? '' : 's' %>
                shown
            </span>

        </div>

    </header>


    <!-- =======================================================
         TOOLBAR
    ======================================================== -->

    <section class="receipt-toolbar">


        <!-- Search -->

        <form
            method="GET"
            action="/receipts"
            class="search-form"
        >

            <div class="search-wrapper">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input
                    type="text"
                    name="search"
                    class="search-input"
                    placeholder="Search patient name, phone, or ID..."
                    value="<%= typeof search !== 'undefined' ? search : '' %>"
                    autocomplete="off"
                >

            </div>


            <button
                type="submit"
                class="search-btn"
            >

                <i class="fa-solid fa-search"></i>

                Search

            </button>

        </form>


        <!-- New Receipt -->

        <a
            href="/receipt"
            class="new-receipt-btn"
        >

            <i class="fa-solid fa-plus"></i>

            New Receipt

        </a>

    </section>


    <!-- =======================================================
         SEARCH STATUS
    ======================================================== -->

    <% if (search) { %>

        <div class="search-state">

            Search results for:

            <strong>
                "<%= search %>"
            </strong>

            <a
                href="/receipts"
                class="clear-search"
            >
                Clear search
            </a>

        </div>

    <% } %>


    <!-- =======================================================
         RECEIPTS CARD
    ======================================================== -->

    <section class="receipts-card">


        <!-- ===================================================
             TABLE HEADER
        ==================================================== -->

        <div class="table-header">

            <h2 class="table-title">

                <i class="fa-solid fa-list"></i>

                Receipt Records

            </h2>


            <span class="table-count">

                <%= receipts ? receipts.length : 0 %>

            </span>

        </div>


        <% if (receipts && receipts.length > 0) { %>


            <!-- =================================================
                 RECEIPTS TABLE
            ================================================== -->

            <div class="table-wrapper">

                <table class="receipts-table">

                    <thead>

                        <tr>

                            <th>Receipt</th>

                            <th>Date</th>

                            <th>Patient</th>

                            <th>Contact</th>

                            <th>Amount Paid</th>

                            <th>Payment</th>

                            <th>Balance</th>

                            <th>Actions</th>

                        </tr>

                    </thead>


                    <tbody>


                        <% receipts.forEach(receipt => { %>

                            <%
                                const patientName =
                                    receipt.patient_name || 'N/A';

                                const patientInitial =
                                    patientName
                                        .trim()
                                        .charAt(0)
                                        .toUpperCase();

                                const formattedPhone =
                                    formatPhone(
                                        receipt.patient_phone || ''
                                    );

                                const whatsappPhone =
                                    String(
                                        receipt.patient_phone || ''
                                    ).replace(/\D/g, '');

                                const whatsappMessage =
                                    `Hello ${patientName}, ` +
                                    `thank you for choosing Shine Dental Surgery. ` +
                                    `For inquiries or appointments, ` +
                                    `call/WhatsApp us on: ` +
                                    `+256702608900 | +256705026289`;

                                const whatsappUrl =
                                    `https://wa.me/${whatsappPhone}` +
                                    `?text=${encodeURIComponent(
                                        whatsappMessage
                                    )}`;

                                const balance =
                                    Number(
                                        receipt.balance || 0
                                    );

                                const paymentMethod =
                                    String(
                                        receipt.mode_of_payment || ''
                                    ).toLowerCase();

                                let paymentClass = '';

                                if (paymentMethod.includes('cash')) {
                                    paymentClass = 'cash';
                                } else if (
                                    paymentMethod.includes('mobile')
                                ) {
                                    paymentClass = 'mobile';
                                } else if (
                                    paymentMethod.includes('visa')
                                ) {
                                    paymentClass = 'visa';
                                }
                            %>


                            <tr>


                                <!-- =================================
                                     RECEIPT ID
                                ================================== -->

                                <td>

                                    <span class="receipt-id">

                                        <i class="fa-solid fa-hashtag"></i>

                                        <%= receipt.id %>

                                    </span>

                                </td>


                                <!-- =================================
                                     DATE
                                ================================== -->

                                <td>

                                    <div class="date-cell">

                                        <span class="date-main">

                                            <%= new Date(
                                                receipt.created_at
                                            ).toLocaleDateString(
                                                'en-GB'
                                            ) %>

                                        </span>

                                        <span class="date-secondary">
                                            Receipt date
                                        </span>

                                    </div>

                                </td>


                                <!-- =================================
                                     PATIENT
                                ================================== -->

                                <td>

                                    <div class="patient-cell">

                                        <div class="patient-avatar">

                                            <%= patientInitial %>

                                        </div>


                                        <div class="patient-details">

                                            <a
                                                href="/receiptDetails/<%= receipt.id %>?patient_id=<%= receipt.id %>"
                                                class="patient-name-link"
                                            >
                                                <%= patientName %>
                                            </a>

                                            <span class="patient-label">
                                                Patient
                                            </span>

                                        </div>

                                    </div>

                                </td>


                                <!-- =================================
                                     PHONE
                                ================================== -->

                                <td>

                                    <% if (receipt.patient_phone) { %>

                                        <a
                                            href="<%= whatsappUrl %>"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="phone-link"
                                            title="Send WhatsApp message"
                                        >

                                            <i class="fa-brands fa-whatsapp whatsapp-icon"></i>

                                            <%= formattedPhone %>

                                        </a>

                                    <% } else { %>

                                        <span class="currency">
                                            No phone
                                        </span>

                                    <% } %>

                                </td>


                                <!-- =================================
                                     AMOUNT PAID
                                ================================== -->

                                <td>

                                    <span class="amount">

                                        UGX
                                        <%= Number(
                                            receipt.amount_paid || 0
                                        ).toLocaleString('en-US') %>

                                    </span>

                                </td>


                                <!-- =================================
                                     PAYMENT METHOD
                                ================================== -->

                                <td>

                                    <span class="payment-badge <%= paymentClass %>">

                                        <% if (paymentClass === 'cash') { %>

                                            <i class="fa-solid fa-coins"></i>

                                        <% } else if (paymentClass === 'mobile') { %>

                                            <i class="fa-solid fa-mobile-screen-button"></i>

                                        <% } else if (paymentClass === 'visa') { %>

                                            <i class="fa-solid fa-credit-card"></i>

                                        <% } else { %>

                                            <i class="fa-solid fa-wallet"></i>

                                        <% } %>

                                        <%= receipt.mode_of_payment || 'Unknown' %>

                                    </span>

                                </td>


                                <!-- =================================
                                     BALANCE
                                ================================== -->

                                <td>

                                    <% if (balance > 0) { %>

                                        <span class="balance-badge pending">

                                            <i class="fa-solid fa-circle-exclamation"></i>

                                            UGX
                                            <%= balance.toLocaleString(
                                                'en-US'
                                            ) %>

                                        </span>

                                    <% } else { %>

                                        <span class="balance-badge paid">

                                            <i class="fa-solid fa-circle-check"></i>

                                            Paid

                                        </span>

                                    <% } %>

                                </td>


                                <!-- =================================
                                     ACTIONS
                                ================================== -->

                                <td>

                                    <div class="action-group">


                                        <!-- View Patient -->

                                        <a
                                            href="/receipts/patient/<%= encodeURIComponent(
                                                patientName
                                            ) %>"
                                            class="action-btn history-btn"
                                            title="View patient history"
                                        >

                                            <i class="fa-solid fa-user"></i>

                                            Patient

                                        </a>


                                        <!-- Delete -->
                                        <% if (
                                            user &&
                                            user.usertype === 'admin'
                                        ) { %>

                                            <button
                                                type="button"
                                                class="action-btn delete-btn"
                                                onclick="deleteReceipt('<%= receipt.id %>')"
                                                title="Delete receipt"
                                            >

                                                <i class="fa-solid fa-trash"></i>

                                                Delete

                                            </button>

                                        <% } %>

                                    </div>

                                </td>


                            </tr>

                        <% }) %>


                    </tbody>

                </table>

            </div>


            <!-- =================================================
                 TABLE FOOTER
            ================================================== -->

            <div class="table-footer">

                <span class="results-info">

                    Showing

                    <strong>
                        <%= receipts.length %>
                    </strong>

                    receipt<%= receipts.length === 1 ? '' : 's' %>

                    <% if (search) { %>

                        for
                        <strong>
                            "<%= search %>"
                        </strong>

                    <% } %>

                </span>


                <span class="results-info">

                    <i class="fa-solid fa-circle-check"></i>

                    Shine Dental Surgery

                </span>

            </div>


        <% } else { %>


            <!-- =================================================
                 EMPTY STATE
            ================================================== -->

            <div class="empty-state">

                <div class="empty-icon">

                    <i class="fa-solid fa-receipt"></i>

                </div>


                <% if (search) { %>

                    <h3>
                        No Receipts Found
                    </h3>

                    <p>
                        No receipt records matched
                        "<strong><%= search %></strong>".
                        Try searching by another patient name,
                        phone number, or receipt ID.
                    </p>

                <% } else { %>

                    <h3>
                        No Receipts Yet
                    </h3>

                    <p>
                        There are currently no receipt records
                        available. Create a new receipt to get started.
                    </p>

                <% } %>

            </div>


        <% } %>


    </section>


    <!-- =======================================================
         PAGINATION
    ======================================================== -->

    <% if (
        pagination &&
        pagination.totalPages > 1
    ) { %>

        <nav
            class="pagination"
            aria-label="Receipt pagination"
        >


            <% if (pagination.hasPrevPage) { %>

                <a
                    class="page-link"
                    href="/receipts?page=<%= pagination.page - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
                >

                    <i class="fa-solid fa-chevron-left"></i>

                    Previous

                </a>

            <% } %>


            <span class="page-info">

                Page
                <strong>
                    <%= pagination.page %>
                </strong>
                of
                <strong>
                    <%= pagination.totalPages %>
                </strong>

            </span>


            <% if (pagination.hasNextPage) { %>

                <a
                    class="page-link"
                    href="/receipts?page=<%= pagination.page + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
                >

                    Next

                    <i class="fa-solid fa-chevron-right"></i>

                </a>

            <% } %>


        </nav>

    <% } %>


</div>


<!-- =========================================================
     SCROLL TO BOTTOM BUTTON
========================================================= -->

<button
    id="scrollToBottomBtn"
    type="button"
    title="Scroll to bottom"
    aria-label="Scroll to bottom"
>
    <i class="fa-solid fa-arrow-down"></i>
</button>


<script>
    /* =========================================================
       DELETE RECEIPT
    ========================================================= */

    async function deleteReceipt(receiptId) {

        const confirmed =
            window.confirm(
                'Are you sure you want to delete this receipt?'
            );


        if (!confirmed) {
            return;
        }


        try {

            const response =
                await fetch(
                    `/receipts/delete/${encodeURIComponent(receiptId)}`,
                    {
                        method: 'DELETE'
                    }
                );


            const result =
                await response.json();


            if (response.ok) {

                alert(
                    result.message ||
                    'Receipt deleted successfully.'
                );

                window.location.reload();

                return;
            }


            alert(
                result.message ||
                'Error deleting receipt.'
            );

        } catch (error) {

            console.error(
                'Delete receipt error:',
                error
            );

            alert(
                'Unable to delete the receipt. Please try again.'
            );
        }
    }


    /* =========================================================
       SCROLL TO BOTTOM
    ========================================================= */

    const scrollToBottomBtn =
        document.getElementById(
            'scrollToBottomBtn'
        );


    function updateScrollButton() {

        if (window.scrollY > 300) {

            scrollToBottomBtn.style.display =
                'flex';

        } else {

            scrollToBottomBtn.style.display =
                'none';
        }
    }


    window.addEventListener(
        'scroll',
        updateScrollButton,
        { passive: true }
    );


    scrollToBottomBtn.addEventListener(
        'click',
        function () {

            window.scrollTo({

                top:
                    document.documentElement
                        .scrollHeight,

                behavior: 'smooth'

            });
        }
    );


    updateScrollButton();
</script>