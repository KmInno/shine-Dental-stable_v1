
<title>Create New Invoice</title>

<style>
    /* =========================================================
       DESIGN SYSTEM
    ========================================================= */

    :root {
        --invoice-primary: #589f14;
        --invoice-primary-dark: #467f10;
        --invoice-primary-light: #eef7e6;

        --invoice-blue: #2563eb;
        --invoice-blue-light: #eff6ff;

        --invoice-success: #16a34a;
        --invoice-success-light: #ecfdf3;

        --invoice-danger: #dc2626;
        --invoice-danger-dark: #b91c1c;
        --invoice-danger-light: #fef2f2;

        --invoice-text-strong: #17202b;
        --invoice-text: #4b5563;
        --invoice-text-soft: #8a94a3;

        --invoice-border: #e4e8ee;
        --invoice-background: #f5f7fa;
        --invoice-surface: #ffffff;

        --invoice-radius-sm: 8px;
        --invoice-radius-md: 12px;
        --invoice-radius-lg: 16px;

        --invoice-shadow-sm:
            0 2px 8px rgba(15, 23, 42, 0.05);

        --invoice-shadow-md:
            0 8px 24px rgba(15, 23, 42, 0.08);
    }


    /* =========================================================
       GLOBAL
    ========================================================= */

    .invoice-form-page,
    .invoice-form-page * {
        box-sizing: border-box;
    }

    .invoice-form-page {
        width: 100%;
        max-width: 1000px;

        margin: 0 auto;
        padding: 30px 20px 60px;

        background: var(--invoice-background);
        color: var(--invoice-text);

        font-family:
            Arial,
            Helvetica,
            sans-serif;
    }


    /* =========================================================
       PAGE HEADER
    ========================================================= */

    .invoice-page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;

        margin-bottom: 24px;
    }

    .invoice-header-main {
        min-width: 0;
    }

    .invoice-page-title {
        display: flex;
        align-items: center;
        gap: 11px;

        margin: 0 0 6px;

        color: var(--invoice-text-strong);

        font-size: 28px;
        font-weight: 700;
        line-height: 1.2;
    }

    .invoice-page-title i {
        color: var(--invoice-primary);
    }

    .invoice-page-subtitle {
        margin: 0;

        color: var(--invoice-text-soft);

        font-size: 13px;
        line-height: 1.6;
    }

    .invoice-page-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;

        padding: 10px 13px;

        border: 1px solid var(--invoice-border);
        border-radius: 999px;

        background: var(--invoice-surface);
        color: var(--invoice-text);

        font-size: 11px;
        font-weight: 700;

        box-shadow: var(--invoice-shadow-sm);

        white-space: nowrap;
    }

    .invoice-page-badge i {
        color: var(--invoice-primary);
    }


    /* =========================================================
       FORM LAYOUT
    ========================================================= */

    .invoice-form {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }


    /* =========================================================
       SECTION CARD
    ========================================================= */

    .invoice-section {
        overflow: hidden;

        border: 1px solid var(--invoice-border);
        border-radius: var(--invoice-radius-lg);

        background: var(--invoice-surface);

        box-shadow: var(--invoice-shadow-sm);
    }

    .invoice-section-header {
        display: flex;
        align-items: center;
        gap: 11px;

        padding: 17px 20px;

        border-bottom: 1px solid var(--invoice-border);
    }

    .invoice-section-icon {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 38px;
        height: 38px;

        flex-shrink: 0;

        border-radius: 10px;

        background: var(--invoice-primary-light);
        color: var(--invoice-primary);
    }

    .invoice-section-heading {
        min-width: 0;
    }

    .invoice-section-title {
        margin: 0 0 3px;

        color: var(--invoice-text-strong);

        font-size: 16px;
        font-weight: 700;
    }

    .invoice-section-description {
        margin: 0;

        color: var(--invoice-text-soft);

        font-size: 10px;
        line-height: 1.5;
    }

    .invoice-section-body {
        padding: 20px;
    }


    /* =========================================================
       FORM GRID
    ========================================================= */

    .invoice-grid {
        display: grid;

        grid-template-columns:
            repeat(
                2,
                minmax(0, 1fr)
            );

        gap: 16px;
    }

    .invoice-field {
        min-width: 0;
    }

    .invoice-field.full {
        grid-column: 1 / -1;
    }

    .invoice-label {
        display: flex;
        align-items: center;
        gap: 4px;

        margin-bottom: 6px;

        color: var(--invoice-text-strong);

        font-size: 11px;
        font-weight: 700;
    }

    .required {
        color: var(--invoice-danger);
    }


    /* =========================================================
       INPUTS
    ========================================================= */

    .invoice-control {
        display: block;

        width: 100%;
        min-height: 42px;

        padding: 10px 12px;

        border: 1px solid #d8dee6;
        border-radius: var(--invoice-radius-sm);

        background: #fff;
        color: var(--invoice-text-strong);

        font-family: inherit;
        font-size: 13px;

        outline: none;

        transition:
            border-color .2s ease,
            box-shadow .2s ease;
    }

    .invoice-control:hover {
        border-color: #c7ced8;
    }

    .invoice-control:focus {
        border-color: var(--invoice-primary);

        box-shadow:
            0 0 0 3px rgba(88, 159, 20, .10);
    }

    textarea.invoice-control {
        min-height: 95px;
        resize: vertical;
    }


    /* =========================================================
       INVOICE DATE
    ========================================================= */

    .date-wrapper {
        position: relative;
    }

    .date-wrapper i {
        position: absolute;

        top: 50%;
        right: 13px;

        color: var(--invoice-text-soft);

        transform: translateY(-50%);

        pointer-events: none;
    }

    .date-wrapper .invoice-control {
        padding-right: 38px;
    }


    /* =========================================================
       ITEM TABLE
    ========================================================= */

    .items-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .items-table {
        width: 100%;
        min-width: 780px;

        border-collapse: collapse;
    }

    .items-table thead {
        background: #fafbfc;
    }

    .items-table th {
        padding: 12px;

        border-bottom: 1px solid var(--invoice-border);

        color: #737d8a;

        font-size: 9px;
        font-weight: 700;

        text-align: left;
        text-transform: uppercase;

        letter-spacing: .4px;
        white-space: nowrap;
    }

    .items-table td {
        padding: 10px 12px;

        border-bottom: 1px solid #f0f2f4;

        vertical-align: middle;
    }

    .items-table tbody tr:last-child td {
        border-bottom: none;
    }

    .items-table tbody tr:hover {
        background: #fcfefb;
    }

    .item-input {
        width: 100%;
        min-height: 38px;

        padding: 8px 10px;

        border: 1px solid #d9dee6;
        border-radius: 7px;

        background: #fff;

        color: var(--invoice-text-strong);

        font-family: inherit;
        font-size: 12px;

        outline: none;
    }

    .item-input:focus {
        border-color: var(--invoice-primary);

        box-shadow:
            0 0 0 3px rgba(88, 159, 20, .08);
    }

    .item-name {
        min-width: 220px;
    }

    .item-qty {
        min-width: 75px;
    }

    .item-unit {
        min-width: 100px;
    }

    .item-price {
        min-width: 130px;
    }

    .item-amount {
        min-width: 140px;

        background: #f8fafc;

        font-weight: 700;
    }


    /* =========================================================
       REMOVE ITEM
    ========================================================= */

    .remove-item {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        width: 34px !important;
        height: 34px !important;

        padding: 0 !important;

        border: none;
        border-radius: 8px;

        background: var(--invoice-danger-light);
        color: var(--invoice-danger);

        cursor: pointer;

        transition:
            background .2s ease,
            color .2s ease,
            transform .2s ease;
    }

    .remove-item:hover {
        background: #fee2e2;
        color: var(--invoice-danger-dark);

        transform: scale(1.04);
    }


    /* =========================================================
       ADD ITEM BAR
    ========================================================= */

    .items-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;

        padding: 13px 16px;

        border-top: 1px solid var(--invoice-border);

        background: #fafbfc;
    }

    .add-item-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;

        min-height: 38px;

        padding: 8px 14px;

        border: 1px solid #cfe2bd;
        border-radius: 8px;

        background: var(--invoice-primary-light);
        color: var(--invoice-primary-dark);

        font-size: 11px;
        font-weight: 700;

        cursor: pointer;

        transition:
            background .2s ease,
            border-color .2s ease,
            transform .2s ease;
    }

    .add-item-btn:hover {
        background: #e2f0d5;
        border-color: #bcd6a8;

        transform: translateY(-1px);
    }

    .items-hint {
        color: var(--invoice-text-soft);
        font-size: 10px;
    }


    /* =========================================================
       TOTAL SUMMARY
    ========================================================= */

    .invoice-total-panel {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;

        margin-top: 18px;
        padding: 18px;

        border: 1px solid #dbe9cf;
        border-radius: var(--invoice-radius-md);

        background:
            linear-gradient(
                135deg,
                #f8fcf3,
                #f1f8e9
            );
    }

    .total-label {
        display: flex;
        align-items: center;
        gap: 9px;

        color: var(--invoice-text-strong);

        font-size: 13px;
        font-weight: 700;
    }

    .total-label i {
        color: var(--invoice-primary);
    }

    .total-value {
        display: flex;
        align-items: baseline;
        gap: 6px;

        color: var(--invoice-text-strong);

        font-size: 26px;
        font-weight: 700;

        white-space: nowrap;
    }

    .total-currency {
        color: var(--invoice-text-soft);
        font-size: 10px;
        font-weight: 600;
    }


    /* =========================================================
       SUBMIT
    ========================================================= */

    .form-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;

        padding: 18px 20px;

        border: 1px solid var(--invoice-border);
        border-radius: var(--invoice-radius-lg);

        background: var(--invoice-surface);

        box-shadow: var(--invoice-shadow-sm);
    }

    .form-note {
        display: flex;
        align-items: center;
        gap: 9px;

        color: var(--invoice-text-soft);

        font-size: 10px;
        line-height: 1.5;
    }

    .form-note i {
        color: var(--invoice-primary);

        font-size: 16px;
    }

    .submit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;

        min-height: 44px;

        padding: 10px 22px;

        border: none;
        border-radius: 9px;

        background:
            linear-gradient(
                135deg,
                var(--invoice-primary),
                #6fae30
            );

        color: #fff;

        font-size: 12px;
        font-weight: 700;

        cursor: pointer;

        box-shadow:
            0 5px 14px rgba(88, 159, 20, .20);

        transition:
            background .2s ease,
            transform .2s ease,
            box-shadow .2s ease;
    }

    .submit-btn:hover {
        background:
            linear-gradient(
                135deg,
                var(--invoice-primary-dark),
                #5f9724
            );

        transform: translateY(-1px);

        box-shadow:
            0 8px 18px rgba(88, 159, 20, .25);
    }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @media (max-width: 800px) {

        .invoice-form-page {
            padding: 22px 15px 45px;
        }

        .invoice-page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .invoice-page-badge {
            align-self: flex-start;
        }

        .invoice-grid {
            grid-template-columns: 1fr;
        }

        .invoice-field.full {
            grid-column: auto;
        }

        .invoice-total-panel {
            align-items: flex-start;
            flex-direction: column;
        }

        .form-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .submit-btn {
            width: 100%;
        }
    }


    @media (max-width: 600px) {

        .invoice-page-title {
            font-size: 23px;
        }

        .invoice-section-header,
        .invoice-section-body {
            padding: 16px;
        }

        .items-footer {
            align-items: flex-start;
            flex-direction: column;
        }

        .add-item-btn {
            width: 100%;
        }

        .items-hint {
            display: none;
        }

        .total-value {
            font-size: 23px;
        }
    }
</style>


<!-- =========================================================
     PAGE
========================================================= -->

<div class="invoice-form-page">


    <!-- =======================================================
         PAGE HEADER
    ======================================================== -->

    <header class="invoice-page-header">

        <div class="invoice-header-main">

            <h1 class="invoice-page-title">

                <i class="fa-solid fa-file-invoice"></i>

                Create New Invoice

            </h1>

            <p class="invoice-page-subtitle">

                Create a professional invoice for
                a client and record the services provided.

            </p>

        </div>


        <div class="invoice-page-badge">

            <i class="fa-solid fa-shield-heart"></i>

            Shine Dental Surgery

        </div>

    </header>


    <!-- =======================================================
         FORM
    ======================================================== -->

    <form
        id="invoiceForm"
        class="invoice-form"
        action="/invoices/create"
        method="POST"
    >


        <!-- ===================================================
             CLIENT INFORMATION
        ==================================================== -->

        <section class="invoice-section">


            <div class="invoice-section-header">

                <div class="invoice-section-icon">

                    <i class="fa-solid fa-user"></i>

                </div>


                <div class="invoice-section-heading">

                    <h2 class="invoice-section-title">
                        Client Information
                    </h2>

                    <p class="invoice-section-description">
                        Enter the details of the person or organization being invoiced.
                    </p>

                </div>

            </div>


            <div class="invoice-section-body">

                <div class="invoice-grid">


                    <!-- Client Name -->

                    <div class="invoice-field">

                        <label
                            class="invoice-label"
                            for="clientName"
                        >

                            Client Name

                            <span class="required">
                                *
                            </span>

                        </label>

                        <input
                            id="clientName"
                            type="text"
                            name="client_name"
                            class="invoice-control"
                            required
                            autocomplete="name"
                            placeholder="Enter client name"
                        >

                    </div>


                    <!-- Phone -->

                    <div class="invoice-field">

                        <label
                            class="invoice-label"
                            for="clientTel"
                        >

                            Phone Number

                            <span class="required">
                                *
                            </span>

                        </label>

                        <input
                            id="clientTel"
                            type="tel"
                            name="client_tel"
                            class="invoice-control"
                            required
                            autocomplete="tel"
                            placeholder="+2567XXXXXXXX"
                        >

                    </div>


                    <!-- Address -->

                    <div class="invoice-field full">

                        <label
                            class="invoice-label"
                            for="clientAddress"
                        >

                            Address

                        </label>

                        <textarea
                            id="clientAddress"
                            name="client_address"
                            class="invoice-control"
                            placeholder="Enter client address"
                        ></textarea>

                    </div>

                </div>

            </div>

        </section>


        <!-- ===================================================
             INVOICE INFORMATION
        ==================================================== -->

        <section class="invoice-section">


            <div class="invoice-section-header">

                <div class="invoice-section-icon">

                    <i class="fa-solid fa-calendar-days"></i>

                </div>


                <div class="invoice-section-heading">

                    <h2 class="invoice-section-title">
                        Invoice Information
                    </h2>

                    <p class="invoice-section-description">
                        Set the date associated with this invoice.
                    </p>

                </div>

            </div>


            <div class="invoice-section-body">

                <div class="invoice-grid">


                    <div class="invoice-field">

                        <label
                            class="invoice-label"
                            for="invoiceDate"
                        >

                            Invoice Date

                            <span class="required">
                                *
                            </span>

                        </label>


                        <div class="date-wrapper">

                            <input
                                id="invoiceDate"
                                type="date"
                                name="invoice_date"
                                class="invoice-control"
                                required
                            >

                            <i class="fa-solid fa-calendar"></i>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- ===================================================
             ITEMS
        ==================================================== -->

        <section class="invoice-section">


            <div class="invoice-section-header">

                <div class="invoice-section-icon">

                    <i class="fa-solid fa-list-check"></i>

                </div>


                <div class="invoice-section-heading">

                    <h2 class="invoice-section-title">
                        Invoice Items
                    </h2>

                    <p class="invoice-section-description">
                        Add the products, services, quantities, and prices included in the invoice.
                    </p>

                </div>

            </div>


            <!-- Items Table -->

            <div class="items-table-wrapper">

                <table class="items-table">

                    <thead>

                        <tr>

                            <th>
                                Item / Service
                            </th>

                            <th>
                                Qty
                            </th>

                            <th>
                                Unit
                            </th>

                            <th>
                                Unit Price
                            </th>

                            <th>
                                Amount
                            </th>

                            <th>
                                Remove
                            </th>

                        </tr>

                    </thead>


                    <tbody id="itemsContainer"></tbody>

                </table>

            </div>


            <!-- Items Footer -->

            <div class="items-footer">

                <button
                    type="button"
                    id="addItemBtn"
                    class="add-item-btn"
                >

                    <i class="fa-solid fa-plus"></i>

                    Add Item

                </button>


                <span class="items-hint">

                    Amounts are calculated automatically from
                    quantity × unit price.

                </span>

            </div>


            <!-- Total -->

            <div style="padding: 0 20px 20px;">

                <div class="invoice-total-panel">

                    <div class="total-label">

                        <i class="fa-solid fa-calculator"></i>

                        Total Invoice Amount

                    </div>


                    <div class="total-value">

                        <span id="displayTotal">
                            UGX 0
                        </span>

                    </div>

                </div>

            </div>

        </section>


        <!-- ===================================================
             HIDDEN FIELDS
        ==================================================== -->

        <input
            type="hidden"
            id="total"
            name="total"
            value="0"
        >

        <input
            type="hidden"
            id="items"
            name="items"
            value="[]"
        >


        <!-- ===================================================
             FORM ACTION
        ==================================================== -->

        <section class="form-actions">

            <div class="form-note">

                <i class="fa-solid fa-circle-info"></i>

                <span>
                    Review the client, date, items,
                    and total before creating the invoice.
                </span>

            </div>


            <button
                type="submit"
                class="submit-btn"
            >

                <i class="fa-solid fa-file-circle-check"></i>

                Create Invoice

            </button>

        </section>


    </form>

</div>


<script>
    /* =========================================================
       STATE
    ========================================================= */

    let itemCount = 0;


    /* =========================================================
       DOM REFERENCES
    ========================================================= */

    const invoiceForm =
        document.getElementById(
            'invoiceForm'
        );

    const itemsContainer =
        document.getElementById(
            'itemsContainer'
        );

    const totalInput =
        document.getElementById(
            'total'
        );

    const itemsInput =
        document.getElementById(
            'items'
        );

    const displayTotal =
        document.getElementById(
            'displayTotal'
        );


    /* =========================================================
       MONEY FORMATTER
    ========================================================= */

    function formatMoney(value) {

        return Number(value || 0)
            .toLocaleString(
                'en-US',
                {
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 0
                }
            );
    }


    /* =========================================================
       ADD ITEM
    ========================================================= */

    function addItem() {

        itemCount++;


        const row =
            document.createElement('tr');


        row.className =
            'invoice-item';


        row.dataset.id =
            itemCount;


        row.innerHTML = `

            <td>
                <input
                    type="text"
                    class="item-input item-name"
                    placeholder="Item or service"
                    required
                >
            </td>


            <td>
                <input
                    type="number"
                    class="item-input item-qty"
                    value="1"
                    min="1"
                    step="1"
                    required
                >
            </td>


            <td>
                <input
                    type="text"
                    class="item-input item-unit"
                    placeholder="Piece"
                >
            </td>


            <td>
                <input
                    type="number"
                    class="item-input item-price"
                    value="0"
                    min="0"
                    step="1"
                    required
                >
            </td>


            <td>
                <input
                    type="number"
                    class="item-input item-amount"
                    value="0"
                    readonly
                >
            </td>


            <td>

                <button
                    type="button"
                    class="remove-item"
                    title="Remove item"
                    aria-label="Remove item"
                >

                    <i class="fa-solid fa-trash"></i>

                </button>

            </td>
        `;


        itemsContainer.appendChild(row);


        /* =============================================
           Input Events
        ============================================== */

        row
            .querySelector('.item-qty')
            .addEventListener(
                'input',
                calculateTotal
            );


        row
            .querySelector('.item-price')
            .addEventListener(
                'input',
                calculateTotal
            );


        /*
         * Recalculate when the item name changes
         * so the hidden JSON remains current.
         */
        row
            .querySelector('.item-name')
            .addEventListener(
                'input',
                calculateTotal
            );


        row
            .querySelector('.item-unit')
            .addEventListener(
                'input',
                calculateTotal
            );


        /* =============================================
           Remove Item
        ============================================== */

        row
            .querySelector('.remove-item')
            .addEventListener(
                'click',
                function () {

                    row.remove();

                    calculateTotal();

                }
            );


        calculateTotal();
    }


    /* =========================================================
       REMOVE ITEM BY ID
       Kept as a compatibility helper in case another
       part of the page calls removeItem().
    ========================================================= */

    function removeItem(id) {

        const item =
            document.querySelector(
                `.invoice-item[data-id="${id}"]`
            );


        if (item) {
            item.remove();
        }


        calculateTotal();
    }


    /* =========================================================
       CALCULATE TOTAL
    ========================================================= */

    function calculateTotal() {

        let total = 0;

        const items = [];


        document
            .querySelectorAll(
                '.invoice-item'
            )
            .forEach(entry => {

                const name =
                    entry
                        .querySelector(
                            '.item-name'
                        )
                        .value
                        .trim();


                const qty =
                    parseFloat(
                        entry
                            .querySelector(
                                '.item-qty'
                            )
                            .value
                    ) || 0;


                const unit =
                    entry
                        .querySelector(
                            '.item-unit'
                        )
                        .value
                        .trim();


                const price =
                    parseFloat(
                        entry
                            .querySelector(
                                '.item-price'
                            )
                            .value
                    ) || 0;


                const amount =
                    qty * price;


                entry
                    .querySelector(
                        '.item-amount'
                    )
                    .value =
                    amount;


                items.push({

                    item_name:
                        name,

                    qty:
                        qty,

                    unit:
                        unit,

                    unit_price:
                        price,

                    amount:
                        amount

                });


                total += amount;

            });


        /* Update hidden fields */

        totalInput.value =
            total;


        itemsInput.value =
            JSON.stringify(
                items
            );


        /* Update visible total */

        displayTotal.textContent =
            `UGX ${formatMoney(total)}`;
    }


    /* =========================================================
       FORM SUBMISSION
    ========================================================= */

    invoiceForm.addEventListener(
        'submit',
        function () {

            /*
             * Always recalculate one final time
             * before submitting.
             */
            calculateTotal();

        }
    );


    /* =========================================================
       BUTTON
    ========================================================= */

    document
        .getElementById(
            'addItemBtn'
        )
        .addEventListener(
            'click',
            addItem
        );


    /* =========================================================
       INITIALIZATION
    ========================================================= */

    document.addEventListener(
        'DOMContentLoaded',
        function () {

            /*
             * Create the first invoice item.
             */
            addItem();


            /*
             * Set invoice date to today
             * when the field is empty.
             */
            const invoiceDate =
                document.getElementById(
                    'invoiceDate'
                );


            if (
                invoiceDate &&
                !invoiceDate.value
            ) {

                const today =
                    new Date();

                const year =
                    today.getFullYear();

                const month =
                    String(
                        today.getMonth() + 1
                    ).padStart(
                        2,
                        '0'
                    );

                const day =
                    String(
                        today.getDate()
                    ).padStart(
                        2,
                        '0'
                    );


                invoiceDate.value =
                    `${year}-${month}-${day}`;
            }


            calculateTotal();

        }
    );
</script>
