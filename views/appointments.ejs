
<!-- =========================================================
     FONT AWESOME
========================================================= -->

<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
>


<style>
    /* =========================================================
       DESIGN SYSTEM
    ========================================================= */

    :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --primary-soft: #eff6ff;

        --success: #16a34a;
        --success-soft: #ecfdf3;

        --danger: #dc2626;
        --danger-soft: #fef2f2;

        --warning: #d97706;
        --warning-soft: #fffbeb;

        --whatsapp: #25d366;
        --whatsapp-dark: #1da851;

        --text-dark: #1f2937;
        --text: #4b5563;
        --text-muted: #9ca3af;

        --border: #e5e7eb;
        --background: #f5f7fb;
        --surface: #ffffff;

        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;

        --shadow-sm:
            0 2px 8px rgba(15, 23, 42, 0.05);

        --shadow-md:
            0 8px 24px rgba(15, 23, 42, 0.08);

        --shadow-lg:
            0 16px 40px rgba(15, 23, 42, 0.12);
    }


    /* =========================================================
       PAGE
    ========================================================= */

    body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-family:
            Arial,
            Helvetica,
            sans-serif;
    }

    .appointments-page {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 30px 24px 60px;
    }


    /* =========================================================
       PAGE HEADER
    ========================================================= */

    .appointments-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;

        margin-bottom: 24px;
    }

    .header-main {
        min-width: 0;
    }

    .header-title {
        display: flex;
        align-items: center;
        gap: 12px;

        margin: 0 0 7px;

        color: var(--text-dark);
        font-size: 30px;
        font-weight: 700;
        line-height: 1.2;
    }

    .header-title i {
        color: var(--primary);
    }

    .header-subtitle {
        margin: 0;

        color: var(--text-muted);
        font-size: 14px;
        line-height: 1.6;
    }

    .patient-count {
        display: inline-flex;
        align-items: center;
        gap: 8px;

        padding: 10px 14px;

        border: 1px solid var(--border);
        border-radius: 999px;

        background: var(--surface);
        color: var(--text);

        font-size: 13px;
        font-weight: 600;

        box-shadow: var(--shadow-sm);
        white-space: nowrap;
    }

    .patient-count i {
        color: var(--primary);
    }


    /* =========================================================
       FILTER / NAVIGATION
    ========================================================= */

    .appointment-filters {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;

        margin-bottom: 24px;
        padding: 7px;

        border: 1px solid var(--border);
        border-radius: var(--radius-md);

        background: var(--surface);
        box-shadow: var(--shadow-sm);
    }

    .filter-tabs {
        display: flex;
        gap: 6px;
    }

    .filter-tab {
        display: inline-flex;
        align-items: center;
        gap: 8px;

        padding: 10px 16px;

        border-radius: 9px;

        color: var(--text);
        background: transparent;

        font-size: 14px;
        font-weight: 600;
        text-decoration: none;

        transition:
            background 0.2s ease,
            color 0.2s ease,
            transform 0.2s ease;
    }

    .filter-tab:hover {
        color: var(--primary);
        background: var(--primary-soft);
    }

    .filter-tab.active {
        color: #fff;
        background: var(--primary);
        box-shadow:
            0 4px 10px rgba(37, 99, 235, 0.22);
    }

    .filter-tab.active:hover {
        color: #fff;
        background: var(--primary-dark);
    }

    .filter-summary {
        padding: 0 12px;

        color: var(--text-muted);
        font-size: 13px;
        white-space: nowrap;
    }


    /* =========================================================
       TABLE CARD
    ========================================================= */

    .appointments-card {
        overflow: hidden;

        border: 1px solid var(--border);
        border-radius: var(--radius-lg);

        background: var(--surface);

        box-shadow: var(--shadow-sm);
    }

    .table-header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 18px 22px;

        border-bottom: 1px solid var(--border);
    }

    .table-header-title {
        display: flex;
        align-items: center;
        gap: 10px;

        margin: 0;

        color: var(--text-dark);
        font-size: 16px;
        font-weight: 700;
    }

    .table-header-title i {
        color: var(--primary);
    }

    .table-header-count {
        padding: 5px 9px;

        border-radius: 999px;

        background: var(--primary-soft);
        color: var(--primary);

        font-size: 11px;
        font-weight: 700;
    }


    /* =========================================================
       TABLE WRAPPER
    ========================================================= */

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .appointments-table {
        width: 100%;
        min-width: 900px;

        border-collapse: collapse;
    }

    .appointments-table thead {
        background: #f8fafc;
    }

    .appointments-table th {
        padding: 14px 18px;

        border-bottom: 1px solid var(--border);

        color: #6b7280;

        font-size: 11px;
        font-weight: 700;

        letter-spacing: 0.5px;
        text-align: left;
        text-transform: uppercase;

        white-space: nowrap;
    }

    .appointments-table td {
        padding: 16px 18px;

        border-bottom: 1px solid #f0f1f3;

        color: var(--text);

        font-size: 14px;
        vertical-align: middle;
    }

    .appointments-table tbody tr {
        transition:
            background 0.2s ease,
            box-shadow 0.2s ease;
    }

    .appointments-table tbody tr:hover {
        background: #fafcff;
    }

    .appointments-table tbody tr:last-child td {
        border-bottom: none;
    }


    /* =========================================================
       PATIENT CELL
    ========================================================= */

    .patient-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .patient-avatar {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 38px;
        height: 38px;

        flex-shrink: 0;

        border-radius: 50%;

        background: var(--primary-soft);
        color: var(--primary);

        font-size: 14px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .patient-details {
        display: flex;
        flex-direction: column;
        gap: 3px;

        min-width: 0;
    }

    .patient-name {
        color: var(--text-dark);
        font-weight: 700;

        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .patient-label {
        color: var(--text-muted);
        font-size: 11px;
    }


    /* =========================================================
       PHONE / WHATSAPP
    ========================================================= */

    .phone-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        color: var(--text-dark);
        text-decoration: none;

        transition: color 0.2s ease;
    }

    .phone-link:hover {
        color: var(--whatsapp-dark);
    }

    .whatsapp-icon {
        color: var(--whatsapp);
        font-size: 17px;
    }


    /* =========================================================
       DATE
    ========================================================= */

    .date-cell {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .date-main {
        color: var(--text-dark);
        font-weight: 600;
    }

    .date-label {
        color: var(--text-muted);
        font-size: 11px;
    }


    /* =========================================================
       STATUS BADGES
    ========================================================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;

        padding: 6px 10px;

        border-radius: 999px;

        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-badge i {
        font-size: 8px;
    }

    .status-upcoming {
        background: var(--success-soft);
        color: #15803d;
    }

    .status-none {
        background: #f3f4f6;
        color: #6b7280;
    }


    /* =========================================================
       ROOM
    ========================================================= */

    .room-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        padding: 6px 10px;

        border: 1px solid var(--border);
        border-radius: 7px;

        background: #fafafa;

        color: var(--text);

        font-size: 12px;
        font-weight: 600;
    }

    .room-badge i {
        color: var(--primary);
    }


    /* =========================================================
       VISIT COUNT
    ========================================================= */

    .visit-count {
        display: inline-flex;
        align-items: center;
        gap: 6px;

        padding: 6px 10px;

        border-radius: 7px;

        background: #f3f4f6;
        color: #4b5563;

        font-size: 12px;
        font-weight: 600;
    }

    .visit-count i {
        color: var(--primary);
    }


    /* =========================================================
       ACTION
    ========================================================= */

    .history-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        padding: 8px 12px;

        border: 1px solid #dbe3f0;
        border-radius: 8px;

        background: #fff;
        color: var(--primary);

        font-size: 12px;
        font-weight: 700;
        text-decoration: none;

        transition:
            background 0.2s ease,
            border-color 0.2s ease,
            color 0.2s ease,
            transform 0.2s ease;
    }

    .history-btn:hover {
        border-color: var(--primary);
        background: var(--primary-soft);
        color: var(--primary-dark);
        transform: translateY(-1px);
    }


    /* =========================================================
       TABLE FOOTER
    ========================================================= */

    .table-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 14px 20px;

        border-top: 1px solid var(--border);

        background: #fafbfc;
    }

    .results-text {
        color: var(--text-muted);
        font-size: 13px;
    }

    .results-text strong {
        color: var(--text-dark);
    }


    /* =========================================================
       EMPTY STATE
    ========================================================= */

    .no-data {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        min-height: 320px;
        padding: 50px 20px;

        text-align: center;
    }

    .empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 76px;
        height: 76px;
        margin-bottom: 18px;

        border-radius: 50%;

        background: #f1f5f9;
        color: #cbd5e1;

        font-size: 32px;
    }

    .no-data h3 {
        margin: 0 0 7px;

        color: var(--text-dark);
        font-size: 18px;
    }

    .no-data p {
        max-width: 400px;
        margin: 0;

        color: var(--text-muted);
        font-size: 14px;
        line-height: 1.6;
    }


    /* =========================================================
       SCROLL BUTTON
    ========================================================= */

    #scrollToBottomBtn {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 1000;

        display: none;
        align-items: center;
        justify-content: center;

        width: 48px;
        height: 48px;

        border: none;
        border-radius: 50%;

        background: var(--primary);
        color: #fff;

        font-size: 17px;

        cursor: pointer;

        box-shadow:
            0 8px 20px rgba(37, 99, 235, 0.25);

        transition:
            background 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    #scrollToBottomBtn:hover {
        background: var(--primary-dark);
        transform: translateY(-2px);
        box-shadow:
            0 10px 24px rgba(37, 99, 235, 0.35);
    }

    #scrollToBottomBtn:active {
        transform: scale(0.94);
    }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @media (max-width: 900px) {

        .appointments-page {
            padding: 22px 15px 50px;
        }

        .appointments-header {
            flex-direction: column;
        }

        .patient-count {
            align-self: flex-start;
        }

        .appointment-filters {
            align-items: stretch;
            flex-direction: column;
        }

        .filter-tabs {
            width: 100%;
        }

        .filter-tab {
            flex: 1;
            justify-content: center;
        }

        .filter-summary {
            padding: 4px 10px 8px;
        }
    }


    @media (max-width: 600px) {

        .header-title {
            font-size: 24px;
        }

        .header-subtitle {
            font-size: 13px;
        }

        .filter-tabs {
            flex-direction: column;
        }

        .filter-tab {
            width: 100%;
        }

        .appointments-card {
            border-radius: var(--radius-md);
        }

        .table-header {
            padding: 15px 16px;
        }

        .table-footer {
            padding: 12px 16px;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        .patient-count {
            width: 100%;
            justify-content: center;
        }

        #scrollToBottomBtn {
            right: 16px;
            bottom: 16px;
        }
    }
</style>


<!-- =========================================================
     APPOINTMENTS PAGE
========================================================= -->

<div class="appointments-page">


    <!-- =======================================================
         HEADER
    ======================================================== -->

    <header class="appointments-header">

        <div class="header-main">

            <h1 class="header-title">
                <i class="fa-solid fa-calendar-check"></i>
                Appointments
            </h1>

            <p class="header-subtitle">
                Manage patient visits, upcoming appointments,
                rooms, and treatment history.
            </p>

        </div>


        <div class="patient-count">

            <i class="fa-solid fa-users"></i>

            <span>
                <strong>
                    <%= appointments ? appointments.length : 0 %>
                </strong>
                Patient<%= appointments && appointments.length === 1 ? '' : 's' %>
            </span>

        </div>

    </header>


    <!-- =======================================================
         FILTERS
    ======================================================== -->

    <section class="appointment-filters">

        <nav class="filter-tabs">

            <a
                href="/appointments"
                class="filter-tab <%= !filter || filter === 'all' ? 'active' : '' %>"
            >
                <i class="fa-solid fa-users"></i>
                All Patients
            </a>

            <a
                href="/appointments/upcoming"
                class="filter-tab <%= filter === 'upcoming' ? 'active' : '' %>"
            >
                <i class="fa-solid fa-calendar-day"></i>
                Upcoming Visits
            </a>

        </nav>


        <div class="filter-summary">

            <% if (filter === 'upcoming') { %>

                <i class="fa-solid fa-circle-info"></i>
                Scheduled appointments

            <% } else { %>

                <i class="fa-solid fa-list"></i>
                All patient records

            <% } %>

        </div>

    </section>


    <!-- =======================================================
         APPOINTMENTS CONTENT
    ======================================================== -->

    <section class="appointments-card">


        <% if (appointments && appointments.length > 0) { %>


            <!-- =================================================
                 TABLE HEADER
            ================================================== -->

            <div class="table-header">

                <h2 class="table-header-title">

                    <i class="fa-solid fa-calendar-days"></i>

                    Patient Appointments

                </h2>


                <span class="table-header-count">

                    <%= appointments.length %>

                </span>

            </div>


            <!-- =================================================
                 TABLE
            ================================================== -->

            <div class="table-wrapper">

                <table class="appointments-table">

                    <thead>

                        <tr>

                            <th>Patient</th>

                            <th>Contact</th>

                            <th>Last Visit</th>

                            <th>Next Visit</th>

                            <th>Room</th>

                            <th>Total Visits</th>

                            <th>Action</th>

                        </tr>

                    </thead>


                    <tbody>

                        <% appointments.forEach(appt => { %>

                            <%
                                const patientName =
                                    appt.patient_name || 'N/A';

                                const patientInitial =
                                    patientName
                                        .trim()
                                        .charAt(0)
                                        .toUpperCase();

                                const formattedPhone =
                                    formatPhone(appt.patient_phone);

                                const cleanPhone =
                                    formattedPhone
                                        .replace(/\D/g, '');

                                const appointmentDate =
                                    appt.next_visit
                                        ? new Date(appt.next_visit)
                                            .toLocaleDateString('en-GB')
                                        : '';

                                const whatsappMessage =
                                    `Hello ${patientName}, ` +
                                    `this is a reminder of your upcoming ` +
                                    `appointment at Shine Dental Surgery. ` +
                                    `Your next visit is scheduled for ` +
                                    `${appointmentDate}.`;

                                const whatsappUrl =
                                    `https://wa.me/${cleanPhone}` +
                                    `?text=${encodeURIComponent(
                                        whatsappMessage
                                    )}`;
                            %>


                            <tr>


                                <!-- =================================
                                     PATIENT
                                ================================== -->

                                <td>

                                    <div class="patient-cell">

                                        <div class="patient-avatar">
                                            <%= patientInitial %>
                                        </div>


                                        <div class="patient-details">

                                            <div class="patient-name">
                                                <%= patientName %>
                                            </div>

                                            <div class="patient-label">
                                                Dental Patient
                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <!-- =================================
                                     CONTACT
                                ================================== -->

                                <td>

                                    <a
                                        href="<%= whatsappUrl %>"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="phone-link"
                                        title="Send WhatsApp reminder"
                                    >

                                        <i
                                            class="fa-brands fa-whatsapp whatsapp-icon"
                                        ></i>

                                        <%= formattedPhone %>

                                    </a>

                                </td>


                                <!-- =================================
                                     LAST VISIT
                                ================================== -->

                                <td>

                                    <% if (appt.last_visit) { %>

                                        <div class="date-cell">

                                            <span class="date-main">

                                                <%= new Date(
                                                    appt.last_visit
                                                ).toLocaleDateString(
                                                    'en-GB'
                                                ) %>

                                            </span>

                                            <span class="date-label">
                                                Previous visit
                                            </span>

                                        </div>

                                    <% } else { %>

                                        <span class="status-badge status-none">

                                            <i class="fa-solid fa-circle"></i>

                                            No visits

                                        </span>

                                    <% } %>

                                </td>


                                <!-- =================================
                                     NEXT VISIT
                                ================================== -->

                                <td>

                                    <% if (appt.next_visit) { %>

                                        <span class="status-badge status-upcoming">

                                            <i class="fa-solid fa-circle"></i>

                                            <%= new Date(
                                                appt.next_visit
                                            ).toLocaleDateString(
                                                'en-GB'
                                            ) %>

                                        </span>

                                    <% } else { %>

                                        <span class="status-badge status-none">

                                            <i class="fa-solid fa-minus"></i>

                                            Not scheduled

                                        </span>

                                    <% } %>

                                </td>


                                <!-- =================================
                                     ROOM
                                ================================== -->

                                <td>

                                    <span class="room-badge">

                                        <i class="fa-solid fa-door-open"></i>

                                        <%= appt.room_number || 'N/A' %>

                                    </span>

                                </td>


                                <!-- =================================
                                     VISITS
                                ================================== -->

                                <td>

                                    <span class="visit-count">

                                        <i class="fa-solid fa-clock-rotate-left"></i>

                                        <%= appt.total_visits || 0 %>

                                        <%= (appt.total_visits || 0) === 1
                                            ? 'visit'
                                            : 'visits'
                                        %>

                                    </span>

                                </td>


                                <!-- =================================
                                     ACTION
                                ================================== -->

                                <td>

                                    <a
                                        href="/appointments/<%= appt.patient_phone %>"
                                        class="history-btn"
                                    >

                                        <i class="fa-solid fa-clock-rotate-left"></i>

                                        History

                                    </a>

                                </td>


                            </tr>

                        <% }); %>

                    </tbody>

                </table>

            </div>


            <!-- =================================================
                 TABLE FOOTER
            ================================================== -->

            <div class="table-footer">

                <span class="results-text">

                    Showing
                    <strong>
                        <%= appointments.length %>
                    </strong>
                    patient<%= appointments.length === 1 ? '' : 's' %>

                </span>


                <% if (filter === 'upcoming') { %>

                    <span class="results-text">
                        <i class="fa-solid fa-calendar-check"></i>
                        Upcoming appointments
                    </span>

                <% } else { %>

                    <span class="results-text">
                        <i class="fa-solid fa-users"></i>
                        All patients
                    </span>

                <% } %>

            </div>


        <% } else { %>


            <!-- =================================================
                 EMPTY STATE
            ================================================== -->

            <div class="no-data">

                <div class="empty-icon">

                    <i class="fa-solid fa-calendar-xmark"></i>

                </div>


                <% if (filter === 'upcoming') { %>

                    <h3>
                        No Upcoming Appointments
                    </h3>

                    <p>
                        There are currently no patients with
                        scheduled upcoming visits.
                    </p>

                <% } else { %>

                    <h3>
                        No Patients Found
                    </h3>

                    <p>
                        There are currently no appointment
                        records available.
                    </p>

                <% } %>

            </div>


        <% } %>

    </section>

</div>


<!-- =========================================================
     SCROLL TO BOTTOM
========================================================= -->

<button
    id="scrollToBottomBtn"
    type="button"
    title="Scroll to bottom"
    aria-label="Scroll to bottom"
>
    <i class="fa-solid fa-arrow-down"></i>
</button>


<script>
    /* =========================================================
       SCROLL TO BOTTOM
    ========================================================= */

    const scrollToBottomBtn =
        document.getElementById(
            'scrollToBottomBtn'
        );


    function updateScrollButton() {

        if (window.scrollY > 300) {

            scrollToBottomBtn.style.display = 'flex';

        } else {

            scrollToBottomBtn.style.display = 'none';

        }
    }


    window.addEventListener(
        'scroll',
        updateScrollButton,
        { passive: true }
    );


    scrollToBottomBtn.addEventListener(
        'click',
        function () {

            window.scrollTo({
                top: document.documentElement.scrollHeight,
                behavior: 'smooth'
            });

        }
    );


    /* Initial state */
    updateScrollButton();
</script>